<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sw_product_cost_rule_stats_wizard_form" model="ir.ui.view">
        <field name="name">sw.product.cost.rule.stats.wizard.form</field>
        <field name="model">sw.product.cost.rule.stats.wizard</field>
        <field name="arch" type="xml">
            <form string="Regla de costo - Productos aplicados" create="false" edit="false" delete="false">
                <group>
                    <field name="rule_id"/>
                    <field name="product_count"/>
                </group>
                <group>
                    <field name="product_ids" widget="many2many_tags" options="{'no_create': True}" readonly="1"/>
                </group>
                <footer>
                    <button name="action_open_products" type="object" string="Ver productos" class="btn-primary"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>