<?xml version="1.0" encoding="utf-8"?>

<odoo>


    <record id="sw_product_cost_rule_list_view"
            model="ir.ui.view">

        <field name="name">
            sw.product.cost.rule.list
        </field>

        <field name="model">
            sw.product.cost.rule
        </field>

        <field name="arch"
               type="xml">

            <list>

                <field name="sequence"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="company_id"/>
                <field name="active"/>

            </list>

        </field>

    </record>



    <record id="sw_product_cost_rule_form_view"
            model="ir.ui.view">

        <field name="name">
            sw.product.cost.rule.form
        </field>


        <field name="model">
            sw.product.cost.rule
        </field>


        <field name="arch"
               type="xml">


            <form>


                <sheet>


                    <group>

                        <field name="name"/>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="company_id"/>
                        <field name="rule_type"/>

                    </group>


                    <group>

                        <field name="product_id"
                               invisible="rule_type != 'product'"/>

                        <field name="categ_id"
                               invisible="rule_type != 'category'"/>


                        <field name="brand_id"
                               invisible="rule_type != 'brand'"/>


                    </group>



                    <notebook>


                        <page string="Calculation Steps">


                            <field name="line_ids">


                                <list editable="bottom">


                                    <field name="sequence"/>
                                    <field name="name"/>
                                    <field name="operation"/>
                                    <field name="value_type"/>
                                    <field name="value"/>


                                </list>


                            </field>


                        </page>


                    </notebook>


                </sheet>


            </form>


        </field>

    </record>


</odoo>