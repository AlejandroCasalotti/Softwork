<?xml version="1.0" encoding="utf-8"?>

<odoo>


    <!-- ===================================================== -->
    <!-- COST RULE LIST -->
    <!-- ===================================================== -->

    <record id="sw_product_cost_rule_list_view"
            model="ir.ui.view">

        <field name="name">
            sw.product.cost.rule.list
        </field>

        <field name="model">
            sw.product.cost.rule
        </field>

        <field name="arch"
               type="xml">

            <list>

                <field name="sequence"/>

                <field name="name"/>

                <field name="rule_type"/>

                <field name="company_id"/>

                <field name="active"/>

            </list>

        </field>

    </record>



    <!-- ===================================================== -->
    <!-- COST RULE FORM -->
    <!-- ===================================================== -->

    <record id="sw_product_cost_rule_form_view"
            model="ir.ui.view">


        <field name="name">
            sw.product.cost.rule.form
        </field>


        <field name="model">
            sw.product.cost.rule
        </field>


        <field name="arch"
               type="xml">


            <form>


                <sheet>


                    <group>


                        <group>


                            <field name="name"/>


                            <field name="active"/>


                            <field name="sequence"/>


                            <field name="company_id"/>


                        </group>



                        <group>


                            <field name="rule_type"/>


                            <field name="product_id"
                                   invisible="rule_type != 'product'"/>


                            <field name="categ_id"
                                   invisible="rule_type != 'category'"/>


                            <field name="brand_id"
                                   invisible="rule_type != 'brand'"/>


                        </group>


                    </group>



                    <separator string="Cost Calculation Steps"/>


                    <field name="line_ids">


                        <list editable="bottom">


                            <field name="sequence"/>


                            <field name="name"/>


                            <field name="operation"/>


                            <field name="value_type"/>


                            <field name="value"/>


                            <field name="active"/>


                        </list>


                    </field>



                </sheet>


            </form>


        </field>


    </record>



    <!-- ===================================================== -->
    <!-- ACTION -->
    <!-- ===================================================== -->

    <record id="action_sw_product_cost_rule"
            model="ir.actions.act_window">


        <field name="name">
            Cost Rules
        </field>


        <field name="res_model">
            sw.product.cost.rule
        </field>


        <field name="view_mode">
            list,form
        </field>


    </record>


</odoo>