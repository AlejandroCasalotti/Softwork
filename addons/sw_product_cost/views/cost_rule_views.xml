<?xml version="1.0" encoding="utf-8"?>

<odoo>


<record id="sw_product_cost_rule_list_view" model="ir.ui.view">

    <field name="name">
        sw.product.cost.rule.list
    </field>

    <field name="model">
        sw.product.cost.rule
    </field>

    <field name="arch" type="xml">

        <list>

            <field name="sequence"/>
            <field name="name"/>
            <field name="rule_type"/>
            <field name="company_id"/>
            <field name="active"/>

        </list>

    </field>

</record>



<record id="sw_product_cost_rule_form_view" model="ir.ui.view">

    <field name="name">
        sw.product.cost.rule.form
    </field>

    <field name="model">
        sw.product.cost.rule
    </field>

    <field name="arch" type="xml">

        <form>

            <sheet>

                <group>

                    <field name="name"/>
                    <field name="rule_type"/>
                    <field name="sequence"/>
                    <field name="company_id"/>

                </group>


                <notebook>

                    <page string="Calculation">

                        <field name="line_ids">

                            <list editable="bottom">

                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="operation"/>
                                <field name="value_type"/>
                                <field name="value"/>

                            </list>

                        </field>

                    </page>

                </notebook>


            </sheet>


        </form>


    </field>


</record>


</odoo>