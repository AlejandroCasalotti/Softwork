<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- ===================================================== -->
    <!-- Cost Rule List View -->
    <!-- ===================================================== -->

    <record id="sw_product_cost_rule_tree_view" model="ir.ui.view">

        <field name="name">sw.product.cost.rule.list</field>

        <field name="model">sw.product.cost.rule</field>

        <field name="arch" type="xml">

            <list string="Cost Rules">

                <field name="sequence"/>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="margin_type"/>
                <field name="margin_value"/>
                <field name="company_id"/>
                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- Cost Rule Form View -->
    <!-- ===================================================== -->

    <record id="sw_product_cost_rule_form_view" model="ir.ui.view">

        <field name="name">sw.product.cost.rule.form</field>

        <field name="model">sw.product.cost.rule</field>

        <field name="arch" type="xml">

            <form string="Cost Rule">

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>

                            <field name="name"/>

                        </h1>

                    </div>


                    <group>

                        <group>

                            <field name="active"/>

                            <field name="sequence"/>

                            <field name="company_id"/>

                        </group>


                        <group>

                            <field name="rule_type"/>

                            <field name="margin_type"/>

                            <field name="margin_value"/>

                        </group>

                    </group>


                    <group string="Targets">

                        <field name="product_id"
                               invisible="rule_type != 'product'"/>

                        <field name="categ_id"
                               invisible="rule_type != 'category'"/>

                        <field name="brand_id"
                               invisible="rule_type != 'brand'"/>

                    </group>


                </sheet>

            </form>

        </field>

    </record>


    <!-- ===================================================== -->
    <!-- Window Action -->
    <!-- ===================================================== -->

    <record id="action_sw_product_cost_rules" model="ir.actions.act_window">

        <field name="name">Cost Rules</field>

        <field name="res_model">sw.product.cost.rule</field>

        <field name="view_mode">list,form</field>

    </record>


</odoo>