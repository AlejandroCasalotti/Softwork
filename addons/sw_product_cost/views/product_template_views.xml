<?xml version="1.0" encoding="utf-8"?>

<odoo>


<record id="sw_product_cost_product_template_form_view"
        model="ir.ui.view">


    <field name="name">
        product.template.form.sw.product.cost
    </field>


    <field name="model">
        product.template
    </field>


    <field name="inherit_id"
           ref="product.product_template_only_form_view"/>


    <field name="arch"
           type="xml">


        <xpath expr="//notebook"
               position="inside">


            <page string="Cost Management">


                <group>


                    <field name="sw_cost_rule_id"/>

                    <field name="sw_final_cost"/>

                    <field name="sw_suggested_price"/>


                </group>


            </page>


        </xpath>


    </field>


</record>


</odoo>