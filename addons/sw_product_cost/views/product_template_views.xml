<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- Product Template Cost Information -->

    <record id="sw_product_cost_product_template_form_view"
        model="ir.ui.view">

    <field name="name">product.template.form.sw.product.cost</field>

    <field name="model">product.template</field>

    <field name="inherit_id" ref="product.product_template_only_form_view"/>

    <field name="arch" type="xml">

            <!-- Add Cost Page -->

            <xpath expr="//notebook" position="inside">

                <page string="Cost Management"
                      name="sw_product_cost_page">

                    <group>

                        <group string="Cost Information">

                            <field name="sw_cost_amount"
                                   readonly="1"/>

                            <field name="sw_cost_rule_id"
                                   readonly="1"/>

                            <field name="sw_cost_margin"
                                   readonly="1"/>

                        </group>


                        <group string="Suggested Pricing">

                            <field name="sw_suggested_price"
                                   readonly="1"/>

                        </group>

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>