<?xml version="1.0" encoding="utf-8"?>

<odoo>


    <!-- ===================================================== -->
    <!-- PRODUCT TEMPLATE FORM EXTENSION -->
    <!-- ===================================================== -->

    <record id="sw_product_cost_product_template_form_view"
            model="ir.ui.view">


        <field name="name">product.template.form.sw.product.cost</field>

        <field name="model">product.template</field>


        <field name="inherit_id"
               ref="product.product_template_only_form_view"/>


        <field name="arch"
               type="xml">


            <!-- Insert cost information in General Information -->

            <xpath expr="//sheet/notebook"
                   position="inside">


                <page string="Cost Management"
                      name="sw_cost_management">


                    <group>


                        <group string="Cost Calculation">


                            <field name="sw_cost_rule_id"
                                   readonly="1"/>


                            <field name="sw_base_cost"
                                   readonly="1"/>


                            <field name="sw_final_cost"
                                   readonly="1"/>

                            <field name="sw_sale_margin_percent"/>

                            <field name="sw_suggested_price"
                                   readonly="1"/>

                            <button name="action_sw_recompute_cost_rule"
                                    type="object"
                                    string="Recalcular Regla de Costo"
                                    class="oe_highlight"/>


                        </group>


                    </group>


                </page>


            </xpath>


        </field>


    </record>


</odoo>