<?xml version="1.0" encoding="utf-8"?>

<odoo>


<record id="sw_product_cost_rule_default"
        model="sw.product.cost.rule">


    <field name="name">
        Default Cost Rule
    </field>


    <field name="rule_type">
        global
    </field>


    <field name="sequence">
        100
    </field>


</record>



<record id="sw_product_cost_rule_default_line"
        model="sw.product.cost.rule.line">


    <field name="rule_id"
           ref="sw_product_cost_rule_default"/>


    <field name="name">
        Standard Margin 30%
    </field>


    <field name="sequence">
        10
    </field>


    <field name="operation">
        increase
    </field>


    <field name="value_type">
        percentage
    </field>


    <field name="value">
        30
    </field>


</record>


</odoo>