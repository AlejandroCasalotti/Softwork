<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- List View -->
    <!-- ====================================================== -->

    <record id="view_sw_product_brand_list" model="ir.ui.view">
        <field name="name">sw.product.brand.list</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands" default_order="sequence,name">

                <field name="sequence" widget="handle"/>

                <field name="image_1920"
                       widget="image"
                       options="{'size': [32, 32]}"/>

                <field name="name"/>

                <field name="code"/>

                <field name="country_id"/>

                <field name="product_count"/>

                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>

                <field name="active"
                       widget="boolean_toggle"/>

            </list>
        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Form View -->
    <!-- ====================================================== -->

    <record id="view_sw_product_brand_form" model="ir.ui.view">
        <field name="name">sw.product.brand.form</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">

            <form string="Brand">

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button
                            name="action_open_products"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cubes">

                            <field name="product_count"
                                   widget="statinfo"
                                   string="Products"/>

                        </button>

                    </div>

                    <field name="active" invisible="1"/>

                    <field name="color" invisible="1"/>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>

                            <field name="name"
                                   placeholder="Brand"/>

                        </h1>

                    </div>

                    <group>

                        <group>

                            <field name="image_1920"
                                   widget="image"
                                   class="oe_avatar"/>

                            <field name="code"/>

                            <field name="sequence"/>

                        </group>

                        <group>

                            <field name="country_id"/>

                            <field name="website"/>

                            <field name="email"/>

                            <field name="phone"/>

                            <field name="company_id"
                                   groups="base.group_multi_company"/>

                        </group>

                    </group>

                    <notebook>

                        <page
                            string="Description"
                            name="description">

                            <field name="description"
                                   placeholder="Brand description..."/>

                        </page>

                        <page
                            string="Internal Notes"
                            name="notes">

                            <field name="notes"
                                   widget="html"/>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Search View -->
    <!-- ====================================================== -->

    <record id="view_sw_product_brand_search" model="ir.ui.view">
        <field name="name">sw.product.brand.search</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">

            <search string="Brands">

                <field name="name"/>

                <field name="code"/>

                <field name="country_id"/>

                <separator/>

                <filter
                    string="Active"
                    name="active"
                    domain="[('active','=',True)]"/>

                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active','=',False)]"/>

                <separator/>

                <group>

                    <filter
                        string="Country"
                        name="group_country"
                        context="{'group_by':'country_id'}"/>

                    <filter
                        string="Company"
                        name="group_company"
                        context="{'group_by':'company_id'}"/>

                </group>

            </search>

        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Action -->
    <!-- ====================================================== -->

    <record id="action_sw_product_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">sw.product.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sw_product_brand_search"/>
    </record>

</odoo>