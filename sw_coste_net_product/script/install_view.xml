<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard para ejecutar el script -->
    <record id="action_run_install_view" model="ir.actions.act_window">
        <field name="name">Instalar Vista</field>
        <field name="res_model">install.view.script</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <record id="view_install_view_script_form" model="ir.ui.view">
        <field name="name">install.view.script.form</field>
        <field name="model">install.view.script</field>
        <field name="arch" type="xml">
            <form string="Instalar Vista de Costo Neto">
                <sheet>
                    <p>Haz clic en el botón para instalar la vista heredada en product.supplierinfo</p>
                </sheet>
                <footer>
                    <button name="action_install_view" string="Instalar Vista" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>