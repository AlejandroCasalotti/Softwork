<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista lista de reglas -->
    <record id="view_coste_net_rule_tree" model="ir.ui.view">
        <field name="name">coste_net_rule.tree</field>
        <field name="model">coste_net_rule</field>
        <field name="arch" type="xml">
            <list string="Reglas de Costo">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="total_discount" string="Desc%"/>
                <field name="total_surcharge" string="Rec%"/>
                <field name="total_fixed" string="Fijo"/>
            </list>
        </field>
    </record>

    <!-- Vista formulario de regla -->
    <record id="view_coste_net_rule_form" model="ir.ui.view">
        <field name="name">coste_net_rule.form</field>
        <field name="model">coste_net_rule</field>
        <field name="arch" type="xml">
            <form string="Regla de Costo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="total_discount" readonly="1"/>
                        <field name="total_surcharge" readonly="1"/>
                        <field name="total_fixed" readonly="1"/>
                    </group>
                    <group string="Lineas">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="line_type"/>
                                <field name="value"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Accion de menu - CAMBIADO tree A list -->
    <record id="action_coste_net_rule" model="ir.actions.act_window">
        <field name="name">Reglas de Costo</field>
        <field name="res_model">coste_net_rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu en Compras - CAMBIADO parent A parent_id -->
    <record id="menu_coste_net_rule" model="ir.ui.menu">
        <field name="name">Reglas de Costo</field>
        <field name="action">action_coste_net_rule</field>
        <field name="parent_id">purchase.menu_purchase_configuration</field>
    </record>

    <!-- Heredar vista de proveedor -->
    <record id="view_product_supplierinfo_form_coste" model="ir.ui.view">
        <field name="name">product.supplierinfo.form.costenet</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id">product.product_supplierinfo_form_view</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price']" position="after">
                <field name="rule_id"/>
                <field name="price_net" 
                       readonly="1"
                       attrs="{'invisible': [('rule_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>