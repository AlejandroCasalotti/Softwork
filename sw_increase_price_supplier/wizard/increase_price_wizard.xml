<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para abrir el wizard -->
    <record id="action_increase_price_wizard" model="ir.actions.act_window">
        <field name="name">Aumentar Precio</field>
        <field name="res_model">increase.price.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Vista del wizard -->
    <record id="view_increase_price_wizard_form" model="ir.ui.view">
        <field name="name">increase.price.wizard.form</field>
        <field name="model">increase.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Aumentar Precio de Proveedores">
                <sheet>
                    <group>
                        <field name="supplier_info_ids" widget="many2many_tags" 
                               options="{'no_create': True}" readonly="1" />
                        <field name="percentage" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_increase" string="Aplicar Aumento" 
                            type="object" class="btn-primary" />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Acción de servidor en el menú contextual -->
    <record id="server_action_increase_price" model="ir.actions.server">
        <field name="name">Aumentar Precio</field>
        <field name="model_id" ref="product.model_product_supplierinfo"/>
        <field name="binding_model_id" ref="product.model_product_supplierinfo"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'name': 'Aumentar Precio',
                'type': 'ir.actions.act_window',
                'res_model': 'increase.price.wizard',
                'view_mode': 'form',
                'target': 'new',
            }
        </field>
    </record>

    <!-- Agregar al menú contextual (Context Menu) -->
    <record id="client_action_increase_price" model="ir.actions.client">
        <field name="name">Aumentar Precio</field>
        <field name="tag">increase_price</field>
        <field name="target">new</field>
    </record>
</odoo>