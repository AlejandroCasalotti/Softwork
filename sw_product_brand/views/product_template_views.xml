<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- Product Template -->
    <!-- ====================================================== -->

    <record id="view_product_template_form_sw_brand" model="ir.ui.view">
        <field name="name">product.template.form.sw.brand</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority" eval="90"/>
        <field name="arch" type="xml">

            <!-- Información Comercial -->

            <xpath expr="//sheet/notebook/page[@name='general_information']/group" position="after">

                <group string="Commercial Information"
                       name="sw_commercial_information">

                    <group>

                        <field name="brand_id"
                               options="{'no_open': False}"/>

                    </group>

                    <group>

                        <field name="brand_code"
                               readonly="1"/>

                    </group>

                </group>

            </xpath>

        </field>
    </record>

</odoo>