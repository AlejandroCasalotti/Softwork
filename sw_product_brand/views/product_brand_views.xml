<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ====================================================== -->
    <!-- Tree View -->
    <!-- ====================================================== -->

    <record id="view_sw_product_brand_tree" model="ir.ui.view">
        <field name="name">sw.product.brand.tree</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">
            <list string="Brands" default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="image_1920" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="product_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Form View -->
    <!-- ====================================================== -->

    <record id="view_sw_product_brand_form" model="ir.ui.view">
        <field name="name">sw.product.brand.form</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">

            <form string="Brand">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Brand Name"/>
                        </h1>
                    </div>

                    <group>

                        <group>

                            <field name="image_1920" widget="image"/>

                            <field name="code"/>

                            <field name="sequence"/>

                            <field name="active"/>

                            <field name="company_id"
                                   groups="base.group_multi_company"/>

                        </group>

                        <group>

                            <field name="country_id"/>

                            <field name="website"/>

                            <field name="email"/>

                            <field name="phone"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Description">

                            <field name="description"
                                   placeholder="Brand description..."/>

                        </page>

                        <page string="Internal Notes">

                            <field name="notes"
                                   widget="html"/>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Search View -->
    <!-- ====================================================== -->

    <record id="view_sw_product_brand_search" model="ir.ui.view">
        <field name="name">sw.product.brand.search</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="code"/>

                <field name="country_id"/>

                <separator/>

                <filter
                    string="Active"
                    name="active"
                    domain="[('active','=',True)]"/>

                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active','=',False)]"/>

                <group expand="0" string="Group By">

                    <filter
                        string="Country"
                        context="{'group_by':'country_id'}"/>

                    <filter
                        string="Company"
                        context="{'group_by':'company_id'}"/>

                </group>

            </search>

        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Action -->
    <!-- ====================================================== -->

    <record id="action_sw_product_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">sw.product.brand</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sw_product_brand_search"/>
    </record>

</odoo>