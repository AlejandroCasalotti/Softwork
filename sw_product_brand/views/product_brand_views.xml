<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- Tree View -->
    <!-- ===================================================== -->

    <record id="view_sw_product_brand_tree" model="ir.ui.view">
        <field name="name">sw.product.brand.tree</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">

            <list
                string="Brands"
                default_order="sequence,name">

                <field
                    name="sequence"
                    widget="handle"/>

                <field
                    name="image_1920"
                    widget="image"/>

                <field name="name"/>

                <field name="code"/>

                <field name="country_id"/>

                <field
                    name="product_count"
                    optional="show"/>

                <field
                    name="company_id"
                    optional="hide"
                    groups="base.group_multi_company"/>

                <field
                    name="active"
                    widget="boolean_toggle"/>

            </list>

        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Form View -->
    <!-- ===================================================== -->

    <record id="view_sw_product_brand_form" model="ir.ui.view">
        <field name="name">sw.product.brand.form</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="action_open_products"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cubes">

                        <field
                            name="product_count"
                            widget="statinfo"
                            string="Products"/>

                    </button>

                </header>

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>

                            <field
                                name="name"
                                placeholder="Brand"/>

                        </h1>

                    </div>

                    <group>

                        <group>

                            <field
                                name="image_1920"
                                widget="image"/>

                            <field name="code"/>

                            <field name="sequence"/>

                            <field name="active"/>

                        </group>

                        <group>

                            <field name="country_id"/>

                            <field name="website"/>

                            <field name="email"/>

                            <field name="phone"/>

                            <field
                                name="company_id"
                                groups="base.group_multi_company"/>

                        </group>

                    </group>

                    <notebook>

                        <page
                            name="description"
                            string="Description">

                            <field
                                name="description"/>

                        </page>

                        <page
                            name="notes"
                            string="Internal Notes">

                            <field
                                name="notes"/>

                        </page>

                    </notebook>

                </sheet>

                <div class="oe_chatter">

                    <field name="message_follower_ids"/>

                    <field name="activity_ids"/>

                    <field name="message_ids"/>

                </div>

            </form>

        </field>
    </record>

    <!-- ===================================================== -->
    <!-- Search View -->
    <!-- ===================================================== -->

    <record id="view_sw_product_brand_search" model="ir.ui.view">
        <field name="name">sw.product.brand.search</field>
        <field name="model">sw.product.brand</field>
        <field name="arch" type="xml">

            <search>

                <field name="name"/>

                <field name="code"/>

                <field name="country_id"/>

                <separator/>

                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active','=',True)]"/>

                <filter
                    name="filter_archived"
                    string="Archived"
                    domain="[('active','=',False)]"/>

                <separator/>

                <group>

                    <filter
                        name="group_country"
                        string="Country"
                        context="{'group_by':'country_id'}"/>

                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by':'company_id'}"/>

                </group>

            </search>

        </field>
    </record>

</odoo>