<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_account_tree" model="ir.ui.view">
        <field name="name">sce.account.tree</field>
        <field name="model">sce.account</field>
        <field name="arch" type="xml">
            <list string="Accounts">
                <field name="name"/>
                <field name="connector_id"/>
                <field name="state"/>
                <field name="external_account_ref"/>
                <field name="last_connection_check"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sce_account_form" model="ir.ui.view">
        <field name="name">sce.account.form</field>
        <field name="model">sce.account</field>
        <field name="arch" type="xml">
            <form string="Account">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="connector_id"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="external_account_ref"/>
                            <field name="last_connection_check" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <group string="Credentials">
                        <field name="credentials_json" widget="text"/>
                    </group>
                    <notebook>
                        <page string="Jobs">
                            <field name="job_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="job_type"/>
                                    <field name="state"/>
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sce_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">sce.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>