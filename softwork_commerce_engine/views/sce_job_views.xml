<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_job_tree" model="ir.ui.view">
        <field name="name">sce.job.tree</field>
        <field name="model">sce.job</field>
        <field name="arch" type="xml">
            <list string="Jobs">
                <field name="name"/>
                <field name="job_type"/>
                <field name="state"/>
                <field name="account_id"/>
                <field name="connector_id"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_sce_job_form" model="ir.ui.view">
        <field name="name">sce.job.form</field>
        <field name="model">sce.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="job_type"/>
                            <field name="state"/>
                            <field name="account_id"/>
                            <field name="connector_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="1"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload_json" widget="text"/>
                        </page>
                        <page string="Result">
                            <field name="result_json" widget="text"/>
                        </page>
                        <page string="Error">
                            <field name="error_message" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sce_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">sce.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>