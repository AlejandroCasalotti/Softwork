<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_sce_health_check" model="ir.cron">
        <field name="name">SCE - Health Check</field>
        <field name="model_id" ref="model_sce_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_health_check()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_sce_process_queue" model="ir.cron">
        <field name="name">SCE - Process Queue</field>
        <field name="model_id" ref="model_sce_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_sce_retry_failed_jobs" model="ir.cron">
        <field name="name">SCE - Retry Failed Jobs</field>
        <field name="model_id" ref="model_sce_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_retry_failed_jobs()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_sce_cleanup_old_jobs" model="ir.cron">
        <field name="name">SCE - Cleanup Old Jobs</field>
        <field name="model_id" ref="model_sce_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_old_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_sce_billing_control" model="ir.cron">
        <field name="name">SCE - Billing Control</field>
        <field name="model_id" ref="model_sce_subscription"/>
        <field name="state">code</field>
        <field name="code">model.cron_billing_control()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>