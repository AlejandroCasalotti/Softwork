<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sale_payment_method_tree" model="ir.ui.view">
            <field name="name">sale.payment.method.tree</field>
            <field name="model">sale.payment.method</field>
            <field name="arch" type="xml">
                <list string="Métodos de pago" default_order="sequence asc">
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="percentage_increase"/>
                </list>
            </field>
        </record>

        <record id="view_sale_payment_method_form" model="ir.ui.view">
            <field name="name">sale.payment.method.form</field>
            <field name="model">sale.payment.method</field>
            <field name="arch" type="xml">
                <form string="Método de pago">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="percentage_increase"/>
                            <field name="sequence"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sale_payment_method" model="ir.actions.act_window">
            <field name="name">Métodos de pago</field>
            <field name="res_model">sale.payment.method</field>
            <field name="view_mode">list,form</field>
            
        </record>

        <menuitem
            id="menu_sale_payment_method"
            name="Métodos de pago"
            parent="sale.menu_sale_config"
            action="action_sale_payment_method"
            sequence="50"
        />
    </data>
</odoo>