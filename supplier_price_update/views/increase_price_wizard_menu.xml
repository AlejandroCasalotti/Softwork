<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista form del wizard -->
    <record id="view_increase_price_wizard_form" model="ir.ui.view">
        <field name="name">increase.price.wizard.form</field>
        <field name="model">increase.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Aumentar Precio de Proveedores">
                <sheet>
                    <group>
                        <group string="Configuración del aumento">
                            <field name="percentage" />
                            <field name="apply_to_current_price" />
                            <field name="supplier_info_ids" widget="many2many_tags" 
                                   options="{'no_create': True}" readonly="1" />
                        </group>
                    </group>
                    
                    <group string="Previsualización de cambios" colspan="2">
                        <field name="items_preview" nolabel="1">
                            <tree create="false" delete="false" edit="false">
                                <field name="product_name" />
                                <field name="partner_name" />
                                <field name="current_price" />
                                <field name="new_price" />
                                <field name="price_difference" />
                                <field name="percentage_change" />
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply_increase" string="Aplicar Aumento" 
                            type="object" class="btn-primary" />
                    <button string="Cancelar" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>