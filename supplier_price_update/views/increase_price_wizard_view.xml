<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de servidor para aumentar precio -->
    <record id="action_increase_price" model="ir.actions.server">
        <field name="name">Aumentar Precio</field>
        <field name="model_id" ref="product.model_product_supplierinfo" />
        <field name="binding_model_id" ref="product.model_product_supplierinfo" />
        <field name="state">code</field>
        <field name="code">
            action = records.action_increase_price()
        </field>
    </record>

    <!-- Agregar al menú contextual de product.supplierinfo -->
    <record id="action_increase_price" model="ir.actions.server">
        <!-- El mismo registro de arriba -->
    </record>
</odoo>