<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_sw_initial" model="ir.ui.view">
        <field name="name">purchase.order.form.sw.initial</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Notas">
                    <group>
                        <field name="sw_note" placeholder="Escriba aquí notas internas de la orden de compra..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>