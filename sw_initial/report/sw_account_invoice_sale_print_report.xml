<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_sw_account_sale_print" model="ir.actions.report">
        <field name="name">Imp. Venta</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sw_initial.report_account_move_sale_print</field>
        <field name="report_file">sw_initial.report_account_move_sale_print</field>
        <field name="print_report_name">'Imp. Venta - %s' % (object.name or object.ref or object.id)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">form</field>
    </record>

    <template id="report_account_move_sale_print">
        <t t-call="account.report_invoice_document">
            <t t-set="o" t-value="doc"/>
            <t t-set="display_taxes" t-value="False"/>
        </t>
    </template>

    <template id="report_account_move_sale_print_hide_taxes" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//span[@id='line_tax_ids']/.." position="replace"/>
        <xpath expr="//span[@id='grouped_line_tax_ids']/.." position="replace"/>
        <xpath expr="//t[@t-call='account.document_tax_totals']" position="replace"/>

        <xpath expr="//th[@name='th_subtotal']/span" position="replace">
            <span>Subtotal</span>
        </xpath>
        <xpath expr="//span[@t-field='line.price_subtotal']" position="replace">
            <span t-field="line.price_total"/>
        </xpath>
    </template>
</odoo>