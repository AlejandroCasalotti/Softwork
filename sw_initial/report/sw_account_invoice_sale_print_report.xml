<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_sw_account_sale_print" model="ir.actions.report">
        <field name="name">Imp. Venta</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sw_initial.report_account_move_sale_print</field>
        <field name="report_file">sw_initial.report_account_move_sale_print</field>
        <field name="print_report_name">'Imp. Venta - %s' % (object.name or object.ref or object.id)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">form</field>
    </record>

    <template id="report_account_move_sale_print" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//span[@id='line_tax_ids']/.." position="replace"/>
        <xpath expr="//span[@id='grouped_line_tax_ids']/.." position="replace"/>

        <xpath expr="//t[@t-set='display_taxes']" position="replace">
            <t t-set="display_taxes" t-value="False"/>
        </xpath>

        <xpath expr="//th[@name='th_subtotal']/span" position="replace">
            <span>Subtotal</span>
        </xpath>

        <xpath expr="//span[@t-field='line.price_subtotal']" position="replace">
            <span t-field="line.price_total"/>
        </xpath>
        <xpath expr="//span[@t-field='line.display_subtotal']" position="replace">
            <span t-out="line.display_total"/>
        </xpath>

        <xpath expr="//t[@t-call='account.document_tax_totals']" position="replace"/>

        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_uom" class="text-start"><span>UoM</span></th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_quantity']" position="after">
            <td name="account_invoice_line_uom">
                <span t-field="line.product_uom_id"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_grouped_quantity']" position="after">
            <td name="account_invoice_line_grouped_uom">
                <span t-field="line.product_uom_id"/>
            </td>
        </xpath>

        <xpath expr="//span[@t-field='line.price_unit']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">(line.price_total / line.quantity) if line.quantity else line.price_total</attribute>
            <attribute name="t-options">{'widget': 'monetary', 'display_currency': o.currency_id}</attribute>
        </xpath>
    </template>
</odoo>