<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="payment_method_form_inherit" inherit_id="payment.method_form">
        <xpath expr="//label[hasclass('o_payment_option_label')]" position="after">
            <div class="provider-charge d-none charge-pill" style="border: 1px solid #714b6740; padding: 0px 10px 0 10px; border-radius: 15px; background-color: #714b6740;">
                <span>
                    <t t-esc="provider_sudo.product_id.currency_id.symbol"/>
                    <t t-esc="provider_sudo.product_id.lst_price"/>
                </span>
            </div>
        </xpath>
    </template>
</odoo>