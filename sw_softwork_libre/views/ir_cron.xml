<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_sw_ml_refresh_tokens" model="ir.cron">
        <field name="name">[SW ML] Refresh Tokens</field>
        <field name="model_id" ref="model_sw_ml_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_tokens()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_sw_ml_sync_products" model="ir.cron">
        <field name="name">[SW ML] Run Integrations</field>
        <field name="model_id" ref="model_sw_integration"/>
        <field name="state">code</field>
        <field name="code">model.cron_run_integrations()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_sw_ml_import_orders" model="ir.cron">
        <field name="name">[SW ML] Import Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code">model.cron_ml_import_orders(env)</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">False</field>
    </record>
</odoo>