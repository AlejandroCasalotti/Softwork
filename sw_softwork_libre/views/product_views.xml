<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_sw_ml" model="ir.ui.view">
        <field name="name">product.template.form.sw.ml</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MercadoLibre">
                    <group>
                        <group string="Publicación">
                            <field name="ml_sync_enabled"/>
                            <field name="ml_sync_active"/>
                            <field name="ml_publish_state" readonly="1"/>
                            <field name="ml_item_id" readonly="1"/>
                            <field name="ml_listing_type"/>
                        </group>
                        <group string="Datos base">
                            <field name="ml_sku"/>
                            <field name="ml_effective_sku" readonly="1"/>
                            <field name="ml_listing_description"/>
                            <field name="ml_effective_description" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Stock">
                            <field name="ml_reserved_stock_percent"/>
                            <field name="ml_publish_qty" readonly="1"/>
                        </group>
                        <group string="Precio">
                            <field name="ml_sale_price"/>
                            <field name="ml_effective_sale_price" readonly="1"/>
                            <field name="ml_markup_percent"/>
                            <field name="ml_extra_fee"/>
                            <field name="ml_fee_option_id"/>
                            <field name="ml_fee_markup_percent"/>
                            <field name="ml_net_price" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <group string="Opciones MercadoLibre">
                            <field name="ml_shipping_mode"/>
                            <button name="action_ml_select_shipping" type="object" string="Buscar forma de entrega" class="btn-link"/>
                            <field name="ml_warranty_type"/>
                            <button name="action_ml_select_warranty" type="object" string="Buscar garantía" class="btn-link"/>
                        </group>
                        <group string="Catálogo / Cargos">
                            <button name="action_ml_search_catalog" type="object" string="Buscar en catálogo ML" class="btn-link"/>
                            <button name="action_ml_select_fee_option" type="object" string="Cargos por vender / cuotas" class="btn-link"/>
                            <field name="ml_fee_option_json" widget="text"/>
                        </group>
                    </group>

                    <group string="Fotos de la publicación">
                        <field name="ml_photo_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="is_main"/>
                                <field name="image_1920" widget="image"/>
                            </list>
                        </field>
                    </group>

                    <group>
                        <group>
                            <field name="ml_last_sync" readonly="1"/>
                        </group>
                    </group>

                    <footer>
                        <button name="action_ml_publish_product" type="object" string="PUBLICAR" class="btn-secondary" invisible="ml_publish_state != 'draft'"/>
                        <button name="action_ml_publish_product" type="object" string="PUBLICAR" class="btn-success" invisible="ml_publish_state != 'published'"/>
                        <button name="action_ml_publish_product" type="object" string="VOLVER A PUBLICAR" class="btn-danger" invisible="ml_publish_state != 'deleted'"/>
                        <button name="action_ml_sync_from_odoo" type="object" string="Sincronizar Odoo → ML" class="btn-primary"/>
                        <button name="action_ml_sync_from_ml" type="object" string="Sincronizar ML → Odoo" class="btn-primary"/>
                    </footer>
                </page>
            </xpath>
        </field>
    </record>
</odoo>