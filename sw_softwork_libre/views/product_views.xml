<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_sw_ml" model="ir.ui.view">
        <field name="name">product.template.form.sw.ml</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MercadoLibre">
                    <group>
                        <group>
                            <field name="ml_sync_enabled"/>
                            <field name="ml_item_id"/>
                            <field name="ml_listing_type"/>
                            <field name="ml_last_sync" readonly="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_ml_sync_price_stock" type="object" string="Sincronizar Precio/Stock" class="btn-primary"/>
                    </footer>
                </page>
            </xpath>
        </field>
    </record>
</odoo>