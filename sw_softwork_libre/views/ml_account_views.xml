<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sw_ml_account_tree" model="ir.ui.view">
        <field name="name">sw.ml.account.tree</field>
        <field name="model">sw.ml.account</field>
        <field name="arch" type="xml">
            <list string="Cuentas MercadoLibre">
                <field name="name"/>
                <field name="site_id"/>
                <field name="seller_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sw_ml_account_form" model="ir.ui.view">
        <field name="name">sw.ml.account.form</field>
        <field name="model">sw.ml.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta MercadoLibre">
                <header>
                    <button name="action_exchange_code" type="object" string="Obtener Token" class="btn-primary"/>
                    <button name="action_refresh_token" type="object" string="Refrescar Token"/>
                    <button name="action_create_test_users" type="object" string="Crear usuarios de prueba" class="btn-secondary" invisible="not access_token"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="site_id"/>
                            <field name="seller_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri"/>
                        </group>
                    </group>

                    <group string="OAuth">
                        <field name="oauth_url" readonly="1"/>
                        <field name="auth_code"/>
                    </group>

                    <group string="Tokens">
                        <field name="access_token" password="True"/>
                        <field name="refresh_token" password="True"/>
                        <field name="token_type" readonly="1"/>
                        <field name="token_expires_at" readonly="1"/>
                    </group>

                    <group string="Usuarios de Prueba">
                        <group>
                            <field name="test_buyer_user_id" readonly="1"/>
                            <field name="test_buyer_nickname" readonly="1"/>
                            <field name="test_buyer_password" readonly="1"/>
                        </group>
                        <group>
                            <field name="test_seller_user_id" readonly="1"/>
                            <field name="test_seller_nickname" readonly="1"/>
                            <field name="test_seller_password" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sw_ml_account" model="ir.actions.act_window">
        <field name="name">Cuentas MercadoLibre</field>
        <field name="res_model">sw.ml.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>