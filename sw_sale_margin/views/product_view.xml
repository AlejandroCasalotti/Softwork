<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista en template -->
    <record id="view_product_margin_template" model="ir.ui.view">
        <field name="name">product.template.margin</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="sale_margin"/>
                <field name="sale_price" force_save="1"/>
            </xpath>
        </field>
    </record>

    <!-- Vista en variante -->
    <record id="view_product_margin_product" model="ir.ui.view">
        <field name="name">product.product.margin</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="sale_margin"/>
                <field name="sale_price" force_save="1"/>
            </xpath>
        </field>
    </record>

</odoo>