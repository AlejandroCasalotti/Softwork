<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_sw_uom_web" model="ir.ui.view">
        <field name="name">product.template.form.sw.uom.web</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Embalajes Web">
                    <group>
                        <field
                            name="web_allowed_packaging_ids"
                            widget="many2many_tags"
                            domain="[('id', 'in', uom_ids)]"
                            options="{'no_create_edit': True, 'no_create': True}"
                        />
                        <field name="web_show_base_uom_price"/>
                        <invisible for="web_allowed_packaging_ids" class="text-muted"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>