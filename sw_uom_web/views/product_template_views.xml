<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_sw_uom_web" model="ir.ui.view">
        <field name="name">product.template.form.sw.uom.web</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Venta Web UoM">
                    <group>
                        <field name="web_min_sale_qty"/>
                        <field name="web_sale_uom_id"/>
                    </group>
                    <group>
                        <field name="web_uom_sale_mode" readonly="1"/>
                        <field name="web_sale_uom_price" readonly="1"/>
                        <field name="web_sale_uom_total_text" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>