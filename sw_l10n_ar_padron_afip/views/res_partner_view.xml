<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_afip" model="ir.ui.view">
        <field name="name">res.partner.form.afip</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <group col="4" class="mt-2">
                    <field name="x_afip_cuit" 
                           string="AFIP CUIT"
                           placeholder="11 dígitos sin guiones"
                           class="oe_inline"/>
                    <button name="action_update_from_padron_afip"
                            string="🔄 Consultar AFIP"
                            type="object"
                            class="oe_highlight oe_inline"
                            invisible="not x_afip_cuit"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <group string="Datos AFIP" col="2">
                    <field name="x_estado_padron" readonly="1"/>
                    <field name="x_imp_iva_padron" readonly="1"/>
                    <field name="x_imp_ganancias_padron" readonly="1"/>
                    <field name="x_last_update_padron" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>