<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de Pago Múltiple -->
    <record id="view_account_payment_multi_form" model="ir.ui.view">
        <field name="name">account.payment.multi.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar monto original -->
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Agregar líneas de pago -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="multi_line_ids"/>
            </xpath>
            
            <!-- Mostrar total -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="multi_total" string="Total" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>