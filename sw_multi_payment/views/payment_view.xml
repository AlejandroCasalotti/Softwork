<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_multi_form" model="ir.ui.view">
        <field name="name">account.payment.multi.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <group string="Métodos de Pago">
                    <field name="journal_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="journal_id"/>
                            <field name="amount"/>
                            <field name="reference"/>
                        </list>
                    </field>
                </group>
            </xpath>
            <xpath expr="//field[@name='amount']" position="after">
                <field name="total_amount" string="Total" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>