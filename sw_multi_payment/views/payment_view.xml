<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de Pago Múltiple -->
    <record id="view_account_payment_multi_form" model="ir.ui.view">
        <field name="name">account.payment.multi.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar monto original -->
            <xpath expr="//field[@name='amount']" position="replace">
                <field name="amount" invisible="1"/>
            </xpath>
            
            <!-- Agregar tabla de pagos múltiples después del diario -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <group string="Métodos de Pago">
                    <field name="multi_line_ids" nolabel="1">
                        <list editable="bottom" decoration-success="amount > 0">
                            <field name="sequence" widget="handle"/>
                            <field name="journal_id"/>
                            <field name="amount"/>
                            <field name="reference"/>
                        </list>
                    </field>
                </group>
            </xpath>
            
            <!-- Total -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <group>
                    <field name="multi_total" string="Total" class="oe_subtotal_footer" readonly="1" decoration-success="multi_total > 0"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>