<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de Pago con múltiples diarios -->
    <record id="view_account_payment_multi_form" model="ir.ui.view">
        <field name="name">account.payment.multi.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Agregar diario adicional después del original -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <group string="Agregar Método de Pago">
                    <field name="additional_journal_ids" widget="many2many_tags" placeholder="Agregar más métodos..."/>
                </group>
            </xpath>
            
            <!-- Monto adicionales -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <group string="Detalle de Pagos">
                    <field name="additional_amount_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="journal_id"/>
                            <field name="amount"/>
                            <field name="reference"/>
                        </list>
                    </field>
                </group>
            </xpath>
            
            <!-- Total -->
            <xpath expr="//field[@name='amount']" position="after">
                <field name="total_payment" string="Total" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>