<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de Pago Múltiple -->
    <record id="view_account_payment_multi_form" model="ir.ui.view">
        <field name="name">account.payment.multi.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar monto original -->
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <!-- Agregar líneas de pago -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="multi_line_ids"/>
            </xpath>
            
            <!-- Mostrar total -->
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="multi_total" string="Total" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Acción para Pago Múltiple -->
    <record id="action_account_payment_multi" model="ir.actions.act_window">
        <field name="name">Pago Múltiple</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_multi', '=', True)]</field>
        <field name="context">{'default_payment_type': 'inbound', 'default_is_multi': True}</field>
    </record>

    <!-- Menú en Contabilidad -->
    <record id="menu_account_payment_multi" model="ir.ui.menu">
        <field name="name">Pagos Múltiples</field>
        <field name="action" ref="action_account_payment_multi"/>
        <field name="parent_id" ref="account.menu_account_action_payment"/>
        <field name="sequence">20</field>
    </record>

</odoo>