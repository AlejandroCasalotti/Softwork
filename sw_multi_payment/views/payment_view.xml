<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista formulario de pago -->
    <record id="view_account_payment_multi_form" model="ir.ui.view">
        <field name="name">account.payment.multi.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- Checkbox para multi pago -->
            <xpath expr="//field[@name='date']" position="before">
                <field name="is_multi"/>
                <field name="total_amount" string="Total" readonly="1"/>
            </xpath>
            
            <!-- Líneas de pago múltiples -->
            <xpath expr="//field[@name='date']" position="after">
                <group string="Métodos de Pago" cols="4" invisible="not is_multi">
                    <field name="method_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="journal_id"/>
                            <field name="amount"/>
                            <field name="reference"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>