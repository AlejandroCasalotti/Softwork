<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_payment_multi_tree" model="ir.ui.view">
            <field name="name">payment.multi.tree</field>
            <field name="model">payment.multi</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="payment_date"/>
                    <field name="payment_type"/>
                    <field name="total_amount"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="view_payment_multi_form" model="ir.ui.view">
            <field name="name">payment.multi.form</field>
            <field name="model">payment.multi</field>
            <field name="arch" type="xml">
                <form string="Multi Pago">
                    <header>
                        <button name="action_print_receipt" type="object" string="Imprimir Recibo" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="partner_id"/>
                            </group>
                            <group>
                                <field name="payment_date"/>
                                <field name="payment_type"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Detalle">
                                <field name="line_ids" nolabel="1" context="{'form_view_ref': 'payment_multi_lots_odoo19.view_payment_multi_form'}">
                                    <tree editable="false">
                                        <field name="payment_date"/>
                                        <field name="journal_label"/>
                                        <field name="memo"/>
                                        <field name="amount"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Total">
                                <group>
                                    <field name="total_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </page>
                            <page string="Pagos origen">
                                <field name="payment_ids" widget="many2many_tags" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_payment_multi" model="ir.actions.act_window">
            <field name="name">Multi Pagos</field>
            <field name="res_model">payment.multi</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_payment_multi_root" name="Multi Pagos" sequence="10"/>
        <menuitem id="menu_payment_multi" name="Multi" parent="menu_payment_multi_root" action="action_payment_multi" sequence="10"/>
    </data>
</odoo>

