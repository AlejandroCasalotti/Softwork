<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_account_payment_multi_lots_inherit" model="ir.ui.view">
            <field name="name">account.payment.multi.lots.inherit</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//tree" position="attributes">
                    <attribute name="multi_edit">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="action_account_payment_create_multi" model="ir.actions.server">
            <field name="name">Crear Multi Pago desde Pagos</field>
            <field name="model_id" ref="account.model_account_payment"/>
            <field name="binding_model_id" ref="account.model_account_payment"/>
            <field name="binding_type">action</field>
            <field name="state">code</field>
            <field name="code">
                action = records.env['payment.multi']._create_from_payments(records)
            </field>
        </record>

    </data>
</odoo>