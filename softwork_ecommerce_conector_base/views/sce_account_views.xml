<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_account_tree" model="ir.ui.view">
        <field name="name">sce.account.tree</field>
        <field name="model">sce.account</field>
        <field name="arch" type="xml">
            <list string="Accounts">
                <field name="name"/>
                <field name="connector_id"/>
                <field name="state"/>
                <field name="jobs_done_count"/>
                <field name="jobs_failed_count"/>
                <field name="avg_duration_ms"/>
                <field name="external_account_ref"/>
                <field name="last_connection_check"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sce_account_form" model="ir.ui.view">
        <field name="name">sce.account.form</field>
        <field name="model">sce.account</field>
        <field name="arch" type="xml">
            <form string="Account">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="connector_id"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="external_account_ref"/>
                            <field name="last_connection_check" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <group string="Operational Metrics">
                        <group>
                            <field name="jobs_done_count" readonly="1"/>
                            <field name="jobs_failed_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="avg_duration_ms" readonly="1"/>
                        </group>
                    </group>
                    <group string="Conexión MercadoLibre">
                        <group>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri"/>
                            <field name="oauth_url" readonly="1"/>
                            <field name="provider_timeout_seconds"/>
                        </group>
                        <group>
                            <field name="external_user_id" readonly="1"/>
                            <field name="token_expires_at" readonly="1"/>
                            <field name="token_circuit_open_until" readonly="1"/>
                            <field name="token_refresh_fail_count" readonly="1"/>
                            <field name="last_token_refresh_error" readonly="1"/>
                            <field name="last_connection_check" readonly="1"/>
                            <field name="last_error" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <button name="action_open_oauth_url" type="object" string="Conectar MercadoLibre" class="btn-primary"/>
                        <button name="action_refresh_token" type="object" string="Refrescar Token" invisible="state != 'connected'"/>
                        <button name="action_force_unlock_token_refresh" type="object" string="Forzar desbloqueo refresh" invisible="not token_refresh_in_progress"/>
                        <button name="action_reset_token_circuit" type="object" string="Reset circuit breaker" invisible="not token_circuit_open_until"/>
                    </group>
                    <group string="OAuth / Tokens (advanced)" invisible="1">
                        <group>
                            <field name="auth_code"/>
                            <field name="access_token" password="True"/>
                            <field name="refresh_token" password="True"/>
                            <field name="token_type" readonly="1"/>
                            <field name="token_refresh_in_progress" readonly="1"/>
                            <field name="token_refresh_started_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="credentials_json" widget="text"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Jobs">
                            <field name="job_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="job_type"/>
                                    <field name="state"/>
                                    <field name="started_at"/>
                                    <field name="finished_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sce_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">sce.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>