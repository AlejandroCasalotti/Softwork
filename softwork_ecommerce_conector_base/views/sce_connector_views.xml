<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_connector_tree" model="ir.ui.view">
        <field name="name">sce.connector.tree</field>
        <field name="model">sce.connector</field>
        <field name="arch" type="xml">
            <list string="Connectors">
                <field name="name"/>
                <field name="code"/>
                <field name="provider_type"/>
                <field name="state"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_sce_connector_form" model="ir.ui.view">
        <field name="name">sce.connector.form</field>
        <field name="model">sce.connector</field>
        <field name="arch" type="xml">
            <form string="Connector">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="provider_type"/>
                            <field name="state"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="provider_impl_path" placeholder="softwork_provider_mercadolibre.services.provider.get_provider"/>
                            <field name="force_external_provider"/>
                            <field name="healthcheck_enabled"/>
                            <field name="oauth_refresh_enabled"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts">
                            <field name="account_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="external_account_ref"/>
                                    <field name="last_connection_check"/>
                                    <field name="company_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sce_connector" model="ir.actions.act_window">
        <field name="name">Connectors</field>
        <field name="res_model">sce.connector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>