<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_connector_tree" model="ir.ui.view">
        <field name="name">sce.connector.tree</field>
        <field name="model">sce.connector</field>
        <field name="arch" type="xml">
            <list string="Conectores">
                <field name="name"/>
                <field name="user_id"/>
                <field name="provider_type"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_sce_connector_form" model="ir.ui.view">
        <field name="name">sce.connector.form</field>
        <field name="model">sce.connector</field>
        <field name="arch" type="xml">
            <form string="Conector">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id" readonly="1"/>
                            <field name="provider_type"/>
                            <field name="state"/>
                            <field name="code" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="provider_impl_path" invisible="1"/>
                            <field name="force_external_provider" invisible="1"/>
                            <field name="healthcheck_enabled" invisible="1"/>
                            <field name="oauth_refresh_enabled" invisible="1"/>
                            <field name="description" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounts">
                            <field name="account_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="state"/>
                                    <field name="external_account_ref"/>
                                    <field name="last_connection_check"/>
                                    <field name="company_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sce_connector" model="ir.actions.act_window">
        <field name="name">Conectores</field>
        <field name="res_model">sce.connector</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>