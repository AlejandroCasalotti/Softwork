<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Lista: Reglas -->
        <record id="view_cost_rule_list" model="ir.ui.view">
            <field name="name">cost.rule.list</field>
            <field name="model">cost.rule</field>
            <field name="arch" type="xml">
                <list string="Reglas de Costo" editable="top">
                    <field name="active" widget="boolean_toggle"/>
                    <field name="name"/>
                    <field name="rule_type"/>
                    <field name="rule_mode"/>
                    <field name="rule_value"/>
                </list>
            </field>
        </record>

        <!-- Vista Formulario: Reglas -->
        <record id="view_cost_rule_form" model="ir.ui.view">
            <field name="name">cost.rule.form</field>
            <field name="model">cost.rule</field>
            <field name="arch" type="xml">
                <form string="Regla de Costo">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="rule_type"/>
                            <field name="rule_mode"/>
                            <field name="rule_value"/>
                            <field name="supplier_id"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción -->
        <record id="action_cost_rule" model="ir.actions.act_window">
            <field name="name">Reglas de Costo</field>
            <field name="res_model">cost.rule</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menú -->
        <menuitem id="menu_cost_rule" name="Reglas de Costo" action="action_cost_rule"/>

        <!-- Herencia SupplierInfo -->
        <record id="view_supplierinfo_form" model="ir.ui.view">
            <field name="name">product.supplierinfo.form.inherit</field>
            <field name="model">product.supplierinfo</field>
            <field name="inherit_id" ref="product.product_supplierinfo_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price']" position="after">
                    <field name="sale_margin"/>
                    <field name="rule_ids" widget="many2many_tags"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>