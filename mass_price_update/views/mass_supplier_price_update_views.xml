# -*- coding: utf-8 -*-

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mass_supplier_price_update_form" model="ir.ui.view">
        <field name="name">mass.supplier.price.update.form19</field>
        <field name="model">mass.supplier.price.update</field>
        <field name="arch" type="xml">
            <form string="Actualizar Precio Proveedor Masivo">
                <sheet>
                    <group>
                        <group>
                            <field name="update_type" 
                                   options="{'no_create_edit': True}"/>
                            <field name="new_price" 
                                   attrs="{'invisible': [('update_type', '!=', 'fixed')]}"/>
                            <field name="percentage" 
                                   attrs="{'invisible': [('update_type', '=', 'fixed')]}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="apply_on_variants"/>
                            <field name="update_all_variants" 
                                   attrs="{'invisible': [('apply_on_variants', '=', False)]}"/>
                            <field name="dry_run"/>
                        </group>
                    </group>
                    <field name="product_tmpl_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="standard_price"/>
                            <field name="product_variant_count"/>
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_apply_price_update" 
                            type="object" 
                            string="Vista Previa" 
                            class="btn-info me-2"
                            attrs="{'invisible': [('dry_run', '=', False)]}"/>
                    <button name="action_apply_price_update" 
                            type="object" 
                            string="✅ Aplicar Actualización" 
                            class="btn-success"
                            attrs="{'invisible': [('dry_run', '!=', False)]}"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>