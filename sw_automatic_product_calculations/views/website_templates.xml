<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_page_calculation_block" inherit_id="website_sale.product" name="Website Product Calculation Block">
        <xpath expr="//div[@id='product_details']//form" position="inside">
            <t t-if="product and product.website_enable_calculator and (product.website_calculation_method_ids or product.website_calculation_method_id)">
                <t t-set="website_methods" t-value="product.website_calculation_method_ids or product.website_calculation_method_id"/>
                <div class="card mt-3 o_sw_calc_box" t-att-data-product-template-id="product.id">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Cálculo automático</h5>

                        <div class="row g-2">
                            <div class="col-12">
                                <label class="form-label">Método de cálculo</label>
                                <select class="form-select o_sw_calc_method">
                                    <t t-foreach="website_methods" t-as="m">
                                        <option t-att-value="m.id" t-att-data-method-type="m.method_type">
                                            <t t-esc="m.name"/> (<t t-esc="m.method_type"/>)
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="col-3">
                                <label class="form-label">Largo (m)</label>
                                <input type="number" step="0.01" min="0" class="form-control o_sw_calc_length"/>
                            </div>
                            <div class="col-3">
                                <label class="form-label">Ancho (m)</label>
                                <input type="number" step="0.01" min="0" class="form-control o_sw_calc_width"/>
                            </div>
                            <div class="col-3 o_sw_calc_height_wrap">
                                <label class="form-label">Alto (m)</label>
                                <input type="number" step="0.01" min="0" class="form-control o_sw_calc_height"/>
                            </div>
                            <div class="col-3">
                                <label class="form-label o_sw_calc_total_label">Total</label>
                                <input type="number" step="0.01" min="0" class="form-control o_sw_calc_total_surface"/>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-1">
                            Podés completar largo/ancho/(alto) o ingresar directamente el total. Si completás total, tiene prioridad.
                        </small>

                        <div class="mt-3">
                            <button type="button" class="btn btn-primary o_sw_calc_add_to_cart">
                                Calcular y agregar
                            </button>
                        </div>

                        <div class="alert alert-info mt-3 d-none o_sw_calc_result"></div>
                        <div class="alert alert-danger mt-3 d-none o_sw_calc_error"></div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>