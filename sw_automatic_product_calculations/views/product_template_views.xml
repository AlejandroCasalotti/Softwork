<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inherit_sw_calculation" model="ir.ui.view">
        <field name="name">product.template.form.sw.calculation</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cálculos de producto">
                    <group>
                        <group>
                            <field name="website_enable_calculator"/>
                            <field name="website_calculation_method_id" options="{'no_create_edit': True}"/>
                            <field name="website_calculation_method_ids" widget="many2many_tags" options="{'no_create_edit': True}" groups="base.group_user"/>
                        </group>
                        <group>
                            <field name="website_m2_factor"/>
                            <field name="website_m3_factor"/>
                            <field name="website_featured_qty_type"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>