<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sce_connect_stock_policy_user" model="ir.rule">
        <field name="name">SCE Connect stock policy tenant access</field>
        <field name="model_id" ref="model_sce_connect_stock_policy"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_user'))]"/>
        <field name="domain_force">[("tenant_id.user_ids", "in", [user.id])]</field>
    </record>
    <record id="rule_sce_connect_stock_policy_admin" model="ir.rule">
        <field name="name">SCE Connect administrator stock policy access</field>
        <field name="model_id" ref="model_sce_connect_stock_policy"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_admin'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
    </record>
    <record id="rule_sce_connect_price_policy_user" model="ir.rule">
        <field name="name">SCE Connect price policy tenant access</field>
        <field name="model_id" ref="model_sce_connect_price_policy"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_user'))]"/>
        <field name="domain_force">[("tenant_id.user_ids", "in", [user.id])]</field>
    </record>
    <record id="rule_sce_connect_price_policy_admin" model="ir.rule">
        <field name="name">SCE Connect administrator price policy access</field>
        <field name="model_id" ref="model_sce_connect_price_policy"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_admin'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
    </record>
</odoo>