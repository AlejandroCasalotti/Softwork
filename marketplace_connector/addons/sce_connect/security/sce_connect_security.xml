<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sce_connect" model="ir.module.category">
        <field name="name">SCE Connect</field>
        <field name="sequence">35</field>
    </record>
    <record id="privilege_sce_connect" model="res.groups.privilege">
        <field name="name">SCE Connect</field>
        <field name="category_id" ref="module_category_sce_connect"/>
    </record>
    <record id="group_sce_connect_user" model="res.groups">
        <field name="name">SCE Connect User</field>
        <field name="privilege_id" ref="privilege_sce_connect"/>
    </record>
    <record id="group_sce_connect_admin" model="res.groups">
        <field name="name">SCE Connect Administrator</field>
        <field name="privilege_id" ref="privilege_sce_connect"/>
        <field name="implied_ids" eval="[(4, ref('group_sce_connect_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_sce_tenant_user" model="ir.rule">
        <field name="name">SCE Connect tenant access</field>
        <field name="model_id" ref="model_sce_tenant"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_user'))]"/>
        <field name="domain_force">[("user_ids", "in", [user.id])]</field>
    </record>
    <record id="rule_sce_tenant_admin" model="ir.rule">
        <field name="name">SCE Connect administrator tenant access</field>
        <field name="model_id" ref="model_sce_tenant"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_admin'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
    </record>
    <record id="rule_sce_external_connection_user" model="ir.rule">
        <field name="name">SCE Connect connection tenant access</field>
        <field name="model_id" ref="model_sce_external_connection"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_user'))]"/>
        <field name="domain_force">[("tenant_id.user_ids", "in", [user.id])]</field>
    </record>
    <record id="rule_sce_external_connection_admin" model="ir.rule">
        <field name="name">SCE Connect administrator connection access</field>
        <field name="model_id" ref="model_sce_external_connection"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_admin'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
    </record>
    <record id="rule_sce_secret_user" model="ir.rule">
        <field name="name">SCE Connect secret tenant access</field>
        <field name="model_id" ref="model_sce_secret"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_user'))]"/>
        <field name="domain_force">[("tenant_id.user_ids", "in", [user.id])]</field>
    </record>
    <record id="rule_sce_secret_admin" model="ir.rule">
        <field name="name">SCE Connect administrator secret access</field>
        <field name="model_id" ref="model_sce_secret"/>
        <field name="groups" eval="[(4, ref('group_sce_connect_admin'))]"/>
        <field name="domain_force">[(1, "=", 1)]</field>
    </record>
</odoo>
