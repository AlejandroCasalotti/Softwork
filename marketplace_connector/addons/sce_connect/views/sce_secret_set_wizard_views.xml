<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_secret_set_wizard_form" model="ir.ui.view">
        <field name="name">sce.secret.set.wizard.form</field>
        <field name="model">sce.secret.set.wizard</field>
        <field name="arch" type="xml">
            <form string="Set Secret">
                <group>
                    <field name="secret_id"/>
                    <field name="value" password="True"/>
                </group>
                <footer>
                    <button name="action_set_secret" type="object" string="Save Secret" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
