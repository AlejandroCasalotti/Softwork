<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_connect_rule_list" model="ir.ui.view">
        <field name="name">sce.connect.rule.list</field>
        <field name="model">sce.connect.rule</field>
        <field name="arch" type="xml">
            <list string="Connect Rules">
                <field name="tenant_id"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="scope"/>
                <field name="condition_field"/>
                <field name="operator"/>
                <field name="action"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_sce_connect_rule_form" model="ir.ui.view">
        <field name="name">sce.connect.rule.form</field>
        <field name="model">sce.connect.rule</field>
        <field name="arch" type="xml">
            <form string="Connect Rule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tenant_id"/>
                        <field name="active"/>
                        <field name="sequence"/>
                        <field name="scope"/>
                    </group>
                    <group string="Condition">
                        <field name="condition_field"/>
                        <field name="operator"/>
                        <field name="value"/>
                    </group>
                    <group string="Action">
                        <field name="action"/>
                        <field name="action_value"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sce_connect_rule" model="ir.actions.act_window">
        <field name="name">Connect Rules</field>
        <field name="res_model">sce.connect.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_sce_connect_rule" name="Rules" parent="menu_sce_connect_root"
              action="action_sce_connect_rule" sequence="40"
              groups="sce_connect.group_sce_connect_user"/>
</odoo>