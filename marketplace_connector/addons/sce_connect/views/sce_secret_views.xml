<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_secret_list" model="ir.ui.view">
        <field name="name">sce.secret.list</field>
        <field name="model">sce.secret</field>
        <field name="arch" type="xml">
            <list string="Secrets">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="secret_type"/>
                <field name="masked_value"/>
                <field name="last_rotated_at"/>
            </list>
        </field>
    </record>
    <record id="view_sce_secret_form" model="ir.ui.view">
        <field name="name">sce.secret.form</field>
        <field name="model">sce.secret</field>
        <field name="arch" type="xml">
            <form string="SCE Secret">
                <header>
                    <button name="action_set_value" type="object" string="Set Secret" class="btn-primary" groups="sce_connect.group_sce_connect_admin"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tenant_id"/>
                        <field name="secret_type"/>
                        <field name="masked_value" readonly="1"/>
                        <field name="last_rotated_at" readonly="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sce_secret" model="ir.actions.act_window">
        <field name="name">SCE Secrets</field>
        <field name="res_model">sce.secret</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_sce_connect_secret" name="Secrets" parent="menu_sce_connect_root" action="action_sce_secret" sequence="30" groups="sce_connect.group_sce_connect_admin"/>
</odoo>
