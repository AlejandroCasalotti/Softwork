<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_tenant_list" model="ir.ui.view">
        <field name="name">sce.tenant.list</field>
        <field name="model">sce.tenant</field>
        <field name="arch" type="xml">
            <list string="Tenants">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_sce_tenant_form" model="ir.ui.view">
        <field name="name">sce.tenant.form</field>
        <field name="model">sce.tenant</field>
        <field name="arch" type="xml">
            <form string="SCE Tenant">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="company_id"/>
                        <field name="user_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="External Connections">
                            <field name="external_connection_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sce_tenant" model="ir.actions.act_window">
        <field name="name">SCE Tenants</field>
        <field name="res_model">sce.tenant</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_sce_connect_root" name="SCE Connect" parent="softwork_ecommerce_conector_base.menu_sce_root" sequence="5"/>
    <menuitem id="menu_sce_connect_tenant" name="Tenants" parent="menu_sce_connect_root" action="action_sce_tenant" sequence="10" groups="sce_connect.group_sce_connect_user"/>
</odoo>
