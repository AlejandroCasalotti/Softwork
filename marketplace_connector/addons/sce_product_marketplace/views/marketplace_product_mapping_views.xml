<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_product_mapping_list" model="ir.ui.view">
        <field name="name">marketplace.product.mapping.list</field>
        <field name="model">marketplace.product.mapping</field>
        <field name="arch" type="xml">
            <list string="Mappings de productos">
                <field name="account_id"/>
                <field name="publication_id"/>
                <field name="product_tmpl_id"/>
                <field name="product_id"/>
                <field name="external_id"/>
                <field name="external_variant_id"/>
                <field name="sku"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_product_mapping" model="ir.actions.act_window">
        <field name="name">Mappings de productos</field>
        <field name="res_model">marketplace.product.mapping</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_marketplace_product_mapping"
              name="Mappings de productos"
              parent="sce_product_marketplace.menu_marketplace_publication_root"
              action="action_marketplace_product_mapping"
              sequence="20"/>
</odoo>