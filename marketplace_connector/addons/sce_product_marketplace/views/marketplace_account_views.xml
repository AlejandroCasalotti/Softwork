<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_account_form_marketplace_orders" model="ir.ui.view">
        <field name="name">sce.account.form.marketplace.orders</field>
        <field name="model">sce.account</field>
        <field name="inherit_id" ref="softwork_ecommerce_conector_base.view_sce_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ml_redirect_uri']" position="after">
                <group string="Reglas de órdenes marketplace" invisible="provider_type == 'odoo'">
                    <field name="marketplace_auto_confirm_paid"/>
                    <field name="marketplace_auto_cancelled"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>