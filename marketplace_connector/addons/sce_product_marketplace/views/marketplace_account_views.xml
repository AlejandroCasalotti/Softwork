<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_account_form_marketplace_orders" model="ir.ui.view">
        <field name="name">sce.account.form.marketplace.orders</field>
        <field name="model">sce.account</field>
        <field name="inherit_id" ref="softwork_ecommerce_conector_base.view_sce_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_check_integration_status']" position="after">
                <button name="action_check_products_status" type="object" string="Estados de productos" class="btn-secondary" icon="fa-cubes" invisible="provider_type == 'odoo'"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook invisible="provider_type == 'odoo'">
                    <page string="🔗 Vinculación de Productos" name="page_matching">
                        <group string="Reglas de Emparejamiento &amp; Empresa">
                            <group>
                                <field name="matching_field" widget="radio"/>
                                <field name="exclude_domain" placeholder="[('type', '=', 'service')]"/>
                            </group>
                            <group string="Multicompañía Odoo">
                                <label for="odoo_company_name"/>
                                <div class="o_row">
                                    <field name="odoo_company_name" placeholder="Ej: Mi Empresa / ID 1"/>
                                    <button name="action_fetch_odoo_companies" type="object" icon="fa-search" title="Mapear Compañías desde Odoo" class="btn-secondary btn-sm"/>
                                </div>
                            </group>
                        </group>
                    </page>

                    <page string="📦 Sincronización de Stock" name="page_stock">
                        <group string="Configuración de Stock">
                            <group>
                                <field name="sync_stock"/>
                                <field name="sync_stock_flex" invisible="not sync_stock"/>
                            </group>
                            <group invisible="not sync_stock">
                                <field name="safety_stock"/>
                                <label for="stock_location_name"/>
                                <div class="o_row">
                                    <field name="stock_location_name" placeholder="Ej: WH/Stock / ID 12"/>
                                    <button name="action_fetch_odoo_stock_locations" type="object" icon="fa-search" title="Mapear Almacenes/Ubicaciones de Stock en Odoo" class="btn-secondary btn-sm"/>
                                </div>
                            </group>
                        </group>
                    </page>

                    <page string="🏷️ Sincronización de Precios &amp; Cuotas" name="page_prices">
                        <group>
                            <group string="Reglas de Precio Base">
                                <field name="sync_prices"/>
                                <label for="pricelist_name" invisible="not sync_prices"/>
                                <div class="o_row" invisible="not sync_prices">
                                    <field name="pricelist_name" placeholder="Ej: Tarifa Pública / ID 1"/>
                                    <button name="action_fetch_odoo_pricelists" type="object" icon="fa-search" title="Mapear Listas de Precios en Odoo" class="btn-secondary btn-sm"/>
                                </div>
                                <field name="price_security_factor" invisible="not sync_prices"/>
                                <field name="price_surcharge_fixed" invisible="not sync_prices"/>
                                <field name="price_surcharge_percent" invisible="not sync_prices"/>
                            </group>
                            <group string="Recargo por Cuotas y Modalidad ML" invisible="not sync_prices">
                                <field name="surcharge_clasica_percent"/>
                                <field name="surcharge_premium_percent"/>
                                <field name="free_shipping_threshold"/>
                                <field name="free_shipping_fee"/>
                            </group>
                        </group>
                        <group string="⚡ Simulador de Precios en Vivo" invisible="not sync_prices">
                            <group>
                                <field name="sim_base_price"/>
                            </group>
                            <group>
                                <field name="sim_calculated_clasica" readonly="1" class="oe_bold"/>
                                <field name="sim_calculated_premium" readonly="1" class="oe_bold"/>
                            </group>
                        </group>
                    </page>

                    <page string="🛒 Sincronización de Ventas &amp; Logística" name="page_orders">
                        <group>
                            <group string="Reglas de Ventas">
                                <field name="sync_orders"/>
                                <field name="sync_orders_full" invisible="not sync_orders"/>
                                <field name="marketplace_auto_confirm_paid" invisible="not sync_orders"/>
                                <field name="marketplace_auto_cancelled" invisible="not sync_orders"/>
                            </group>
                            <group string="Mapeo de Almacenes y Equipos" invisible="not sync_orders">
                                <label for="sales_team_name"/>
                                <div class="o_row">
                                    <field name="sales_team_name" placeholder="Ej: Mercado Libre (Si se vacía, se crea automático)"/>
                                    <button name="action_fetch_odoo_sales_teams" type="object" icon="fa-search" title="Mapear Equipos de Ventas en Odoo" class="btn-secondary btn-sm"/>
                                </div>
                                <label for="warehouse_name"/>
                                <div class="o_row">
                                    <field name="warehouse_name" placeholder="Ej: Almacén Principal / ID 1"/>
                                    <button name="action_fetch_odoo_warehouses" type="object" icon="fa-search" title="Mapear Almacenes Estándar en Odoo" class="btn-secondary btn-sm"/>
                                </div>
                                <label for="fulfillment_warehouse_name"/>
                                <div class="o_row">
                                    <field name="fulfillment_warehouse_name" placeholder="Ej: Almacén Full ML / ID 2"/>
                                    <button name="action_fetch_odoo_fulfillment_warehouses" type="object" icon="fa-search" title="Mapear Almacenes Fulfillment en Odoo" class="btn-secondary btn-sm"/>
                                </div>
                            </group>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>