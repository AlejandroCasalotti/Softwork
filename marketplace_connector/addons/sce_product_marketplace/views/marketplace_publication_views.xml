<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_publication_form" model="ir.ui.view">
        <field name="name">marketplace.publication.form</field>
        <field name="model">marketplace.publication</field>
        <field name="arch" type="xml">
            <form string="Publicación en marketplace">
                <header>
                    <button name="action_publish" type="object" string="Publicar"
                        class="btn-primary" invisible="state not in ('draft', 'ready', 'failed')"/>
                    <button name="action_update_marketplace" type="object" string="Actualizar"
                        invisible="state != 'published' or not external_id"/>
                    <button name="action_sync_marketplace_price" type="object" string="Sincronizar precio"
                        invisible="not external_id"/>
                    <button name="action_sync_marketplace_stock" type="object" string="Sincronizar stock"
                        invisible="not external_id"/>
                    <button name="action_delete_marketplace" type="object" string="Retirar publicación"
                        class="btn-secondary" invisible="not external_id" confirm="¿Retirar esta publicación del marketplace?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,category,attributes,pricing,shipping,pictures,ready,published"/>
                </header>
                <sheet>
                    <div class="alert alert-danger" role="alert" invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Cuenta y estado externo">
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="account_id" domain="[('provider_type', '!=', False)]"/>
                            <field name="provider_type" readonly="1"/>
                            <field name="external_id" readonly="1"/>
                            <field name="external_status" readonly="1"/>
                            <field name="external_url" readonly="1" widget="url"/>
                        </group>
                        <group string="Datos comerciales">
                            <field name="title"/>
                            <field name="category_ref"/>
                            <field name="category_name"/>
                            <field name="listing_type"/>
                            <field name="condition"/>
                            <field name="shipping_mode"/>
                        </group>
                    </group>
                    <group>
                        <group string="Precio">
                            <field name="pricelist_id"/>
                            <field name="price_uom_id"/>
                            <field name="use_pricelist_price"/>
                            <field name="manual_price_override"/>
                            <field name="price" readonly="not manual_price_override"/>
                        </group>
                        <group string="Stock">
                            <field name="stock_reserve_qty"/>
                            <field name="effective_qty" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="published_date" readonly="1"/>
                        <field name="sync_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketplace_publication_list" model="ir.ui.view">
        <field name="name">marketplace.publication.list</field>
        <field name="model">marketplace.publication</field>
        <field name="arch" type="xml">
            <list string="Publicaciones en marketplaces">
                <field name="product_tmpl_id"/>
                <field name="account_id"/>
                <field name="provider_type"/>
                <field name="state"/>
                <field name="price"/>
                <field name="effective_qty"/>
                <field name="external_id"/>
            </list>
        </field>
    </record>

    <record id="action_marketplace_publication" model="ir.actions.act_window">
        <field name="name">Publicaciones en marketplaces</field>
        <field name="res_model">marketplace.publication</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_marketplace_publication_root"
              name="Marketplace"
              sequence="60"/>
    <menuitem id="menu_marketplace_publication"
              name="Publicaciones"
              parent="menu_marketplace_publication_root"
              action="action_marketplace_publication"
              sequence="10"/>
</odoo>
