<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_remote_publication_wizard_form" model="ir.ui.view">
        <field name="name">marketplace.remote.publication.wizard.form</field>
        <field name="model">marketplace.remote.publication.wizard</field>
        <field name="arch" type="xml">
            <form string="Publicación remota">
                <header>
                    <button name="action_search_remote_products" type="object" string="Buscar productos" class="btn-primary" icon="fa-search"/>
                    <button name="action_publish_selected" type="object" string="Publicar seleccionados" class="btn-primary" icon="fa-cloud-upload" invisible="selected_count == 0"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Los productos se consultan en vivo desde Odoo. SCE conserva únicamente el mapping mínimo después de publicar.
                    </div>
                    <group>
                        <group string="Origen y destino">
                            <field name="account_id" options="{'no_create': True}"/>
                            <field name="provider_type" readonly="1"/>
                            <field name="search_query" placeholder="Nombre, SKU o código de barras"/>
                        </group>
                        <group string="Valores predeterminados">
                            <field name="default_category_id" placeholder="Ej: MLA1055"/>
                            <field name="default_listing_type"/>
                            <field name="default_condition"/>
                            <field name="default_shipping_mode"/>
                            <button name="action_apply_defaults" type="object" string="Aplicar a seleccionados" class="btn-secondary" icon="fa-check" invisible="selected_count == 0"/>
                        </group>
                    </group>
                    <div class="d-flex gap-2 mb-2" invisible="not line_ids">
                        <button name="action_select_all" type="object" string="Seleccionar todos" class="btn-link"/>
                        <button name="action_clear_selection" type="object" string="Limpiar selección" class="btn-link"/>
                        <span class="text-muted"><field name="selected_count" readonly="1"/> seleccionados</span>
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list editable="bottom" decoration-success="state == 'done'" decoration-warning="state == 'mapped'" decoration-danger="state == 'error'">
                            <field name="selected"/>
                            <field name="name" readonly="1"/>
                            <field name="sku" readonly="1"/>
                            <field name="barcode" readonly="1" optional="hide"/>
                            <field name="forecast_stock" readonly="1"/>
                            <field name="pricelist_price" readonly="1" optional="hide"/>
                            <field name="tax_amount" readonly="1" optional="hide"/>
                            <field name="base_price" readonly="1"/>
                            <field name="account_rule_amount" readonly="1" optional="hide"/>
                            <field name="final_price" readonly="1"/>
                            <field name="title"/>
                            <field name="category_id"/>
                            <field name="listing_type" optional="hide"/>
                            <field name="condition" optional="hide"/>
                            <field name="shipping_mode" optional="hide"/>
                            <field name="picture_url" optional="hide"/>
                            <field name="attributes_json" optional="hide"/>
                            <field name="existing_external_id" readonly="1" optional="show"/>
                            <field name="state" widget="badge"/>
                            <field name="error_message" readonly="1" optional="show"/>
                            <button name="action_open_configuration" type="object" string="Completar" icon="fa-pencil"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_remote_publication_wizard_line_form" model="ir.ui.view">
        <field name="name">marketplace.remote.publication.wizard.line.form</field>
        <field name="model">marketplace.remote.publication.wizard.line</field>
        <field name="arch" type="xml">
            <form string="Completar publicación remota">
                <header>
                    <button name="action_suggest_category" type="object" string="Sugerir categoría" class="btn-primary" icon="fa-magic"/>
                    <button name="action_load_required_attributes" type="object" string="Cargar atributos requeridos" class="btn-secondary" icon="fa-refresh" invisible="not category_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready,mapped,done,error"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Esta información es temporal: se usa para validar y publicar, pero no se copia al catálogo de SCE.
                    </div>
                    <group>
                        <group string="Producto remoto">
                            <field name="name" readonly="1"/>
                            <field name="remote_product_id" readonly="1"/>
                            <field name="sku" readonly="1"/>
                            <field name="barcode" readonly="1"/>
                            <field name="forecast_stock" readonly="1"/>
                            <field name="pricelist_price" readonly="1"/>
                            <field name="tax_amount" readonly="1"/>
                            <field name="base_price" readonly="1"/>
                            <field name="account_rule_amount" readonly="1"/>
                            <field name="final_price" readonly="1"/>
                        </group>
                        <group string="Publicación">
                            <field name="title"/>
                            <field name="category_id" placeholder="Ej: MLA1055"/>
                            <field name="family_name" placeholder="Ej: Línea Premium"/>
                            <field name="brand"/>
                            <field name="model_name"/>
                            <field name="listing_type"/>
                            <field name="condition"/>
                            <field name="shipping_mode"/>
                            <field name="picture_url" placeholder="https://..."/>
                        </group>
                    </group>
                    <group string="Atributos requeridos por Mercado Libre">
                        <field name="attribute_line_ids" nolabel="1">
                            <list editable="bottom" decoration-danger="required and not value_name and not value_id">
                                <field name="required"/>
                                <field name="attribute_name" readonly="1"/>
                                <field name="value_name"/>
                                <field name="value_id" optional="hide"/>
                                <field name="value_type" readonly="1" optional="hide"/>
                                <field name="allowed_values_json" readonly="1" optional="hide"/>
                            </list>
                        </field>
                    </group>
                    <group invisible="not error_message">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                    <footer>
                        <button string="Guardar" special="save" class="btn-primary"/>
                        <button string="Cancelar" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_remote_publication_wizard" model="ir.actions.act_window">
        <field name="name">Publicación remota</field>
        <field name="res_model">marketplace.remote.publication.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_remote_publication"
              name="Publicación remota"
              parent="softwork_ecommerce_conector_base.menu_sce_operations"
              action="action_remote_publication_wizard"
              sequence="5"/>
</odoo>
