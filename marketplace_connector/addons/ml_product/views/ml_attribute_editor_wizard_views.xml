<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ml_attribute_editor_wizard_form" model="ir.ui.view">
        <field name="name">ml.attribute.editor.wizard.form</field>
        <field name="model">ml.attribute.editor.wizard</field>
        <field name="arch" type="xml">
            <form string="Atributos MercadoLibre">
                <group>
                    <field name="product_tmpl_id" readonly="1"/>
                    <field name="account_id" readonly="1"/>
                    <field name="category_id" readonly="1"/>
                </group>

                <group>
                    <button name="action_load_required" type="object" string="Cargar atributos de la categoría" class="btn-primary"/>
                </group>

                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="attribute_id" readonly="1" invisible="1"/>
                        <field name="has_options" readonly="1" invisible="1"/>
                        <field name="value_id" readonly="1" invisible="1"/>
                        <field name="attribute_name" readonly="1" string="Atributo"/>
                        <field name="is_required" readonly="1" string="Oblig."/>
                        <field name="option_id" options="{'no_create': True, 'no_open': True}" string="Opción" invisible="not has_options"/>
                        <field name="value_name" string="Valor" invisible="has_options"/>
                    </list>
                </field>

                <footer>
                    <button name="action_save" type="object" string="Guardar en producto" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>