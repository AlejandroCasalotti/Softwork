<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ml_attribute_option_picker_wizard_form" model="ir.ui.view">
        <field name="name">ml.attribute.option.picker.wizard.form</field>
        <field name="model">ml.attribute.option.picker.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar opción ML">
                <group>
                    <field name="wizard_id" readonly="1"/>
                    <field name="line_id" readonly="1"/>
                </group>
                <group string="Contexto">
                    <field name="category_id" readonly="1"/>
                    <field name="attribute_id" readonly="1"/>
                    <field name="attribute_name" readonly="1"/>
                </group>
                <group string="Opción">
                    <field name="option_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>