<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ml_category_search_wizard_form" model="ir.ui.view">
        <field name="name">ml.category.search.wizard.form</field>
        <field name="model">ml.category.search.wizard</field>
        <field name="arch" type="xml">
            <form string="Buscar Categoría MercadoLibre">
                <group>
                    <field name="product_tmpl_id" invisible="1"/>
                    <field name="account_id"/>
                </group>
                <group>
                    <field name="query"/>
                    <button name="action_search" type="object" string="Buscar" class="btn-primary"/>
                </group>

                <group string="Resultados">
                    <field name="result_line_ids">
                        <list editable="top">
                            <field name="selected"/>
                            <field name="category_name"/>
                            <field name="category_id"/>
                        </list>
                    </field>
                    <field name="result_json" invisible="1"/>
                    <field name="selected_category_id" invisible="1"/>
                </group>

                <footer>
                    <button name="action_apply" type="object" string="Aplicar categoría" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>