<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ml_publish_assistant_wizard_form" model="ir.ui.view">
        <field name="name">ml.publish.assistant.wizard.form</field>
        <field name="model">ml.publish.assistant.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente Único Publicación ML">
                <group>
                    <field name="step" readonly="1"/>
                    <field name="product_tmpl_id" readonly="1"/>
                    <field name="account_id" readonly="1"/>
                    <button name="action_prev" type="object" string="Ir a Paso 1 (Base)" class="btn-secondary" invisible="step == 'base'"/>
                </group>

                <group invisible="step != 'base'" string="Paso 1 - Base">
                    <group>
                        <field name="ml_category_ref_id" options="{'no_create': True}"/>
                        <button name="action_open_category_search" type="object" string="Buscar categoría ML" class="btn-primary"/>
                    </group>
                    <group>
                        <field name="listing_type_id"/>
                        <field name="ml_condition"/>
                    </group>
                    <group string="Datos clave del producto">
                        <field name="ml_brand" placeholder="Ej: Cerámica Alberdi"/>
                        <field name="ml_model" placeholder="Ej: Porcelanato 60x120"/>
                    </group>
                    <button name="action_load_ml_metadata" type="object" string="Cargar metadata de la categoría" class="btn-secondary"/>
                </group>

                <group invisible="step != 'pricing_stock'" string="Paso 2 - Precio y Stock">
                    <field name="ml_pricelist_id"/>
                    <field name="ml_use_pricelist_price"/>
                    <field name="ml_manual_price_override"/>
                    <field name="ml_price" readonly="ml_manual_price_override == False"/>
                    <field name="ml_stock_reserve_qty"/>
                    <field name="ml_effective_qty" readonly="1"/>
                </group>

                <group invisible="step != 'sale_format'" string="Paso 3 - Formato de venta">
                    <field name="ml_sales_unit_value_id" domain="[('account_id', '=', account_id), ('attribute_id', '=', 'SALES_UNIT')]" options="{'no_create': True}"/>
                    <field name="ml_yield_value"/>
                    <field name="ml_yield_unit"/>
                </group>

                <group invisible="step != 'attributes'" string="Paso 4 - Atributos">
                    <div class="o_form_label">Completá primero los atributos marcados como requeridos. Si el atributo tiene opción ML, usá value_id; si no, completá value_name.</div>
                    <field name="attribute_line_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="required" readonly="1"/>
                            <field name="attribute_name" readonly="1"/>
                            <field name="value_id" placeholder="ID opción ML (si aplica)"/>
                            <field name="value_name" placeholder="Valor texto (si no hay opción)"/>
                        </list>
                    </field>
                </group>

                <group invisible="step != 'variants_photos'" string="Paso 5 - Variantes y Fotos">
                    <field name="picture_line_ids">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="source" placeholder="https://..."/>
                        </list>
                    </field>
                    <field name="ml_variant_notes" widget="text" placeholder="Notas de variantes (opcional)."/>
                </group>

                <group invisible="step != 'review'" string="Paso 6 - Revisión final">
                    <button name="action_validate_checklist" type="object" string="Validar checklist" class="btn-secondary"/>
                    <field name="validation_summary" widget="text" readonly="1"/>
                </group>

                <footer>
                    <button name="action_prev" type="object" string="Anterior" class="btn-secondary"/>
                    <button name="action_next" type="object" string="Siguiente" class="btn-secondary"/>
                    <button name="action_apply_to_product" type="object" string="Guardar en producto" class="btn-secondary"/>
                    <button name="action_publish" type="object" string="Publicar en ML" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>