<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ml_publish_assistant_wizard_form" model="ir.ui.view">
        <field name="name">ml.publish.assistant.wizard.form</field>
        <field name="model">ml.publish.assistant.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente de publicación MercadoLibre">
                <group>
                    <group>
                        <field name="progress_indicator" readonly="1" nolabel="1" class="text-muted"/>
                        <field name="product_tmpl_id" readonly="1" label="Producto"/>
                        <field name="account_id" readonly="1" label="Cuenta ML"/>
                    </group>
                </group>

                <div class="alert alert-info" role="alert" invisible="step != 'base'">Elegí la categoría y el tipo de publicación. Luego cargá sus atributos.</div>
                <div class="alert alert-info" role="alert" invisible="step != 'pricing_stock'">Definí el precio y el stock que se enviarán a MercadoLibre.</div>
                <div class="alert alert-info" role="alert" invisible="step != 'sale_format'">Completá la unidad de venta y el rendimiento solo cuando apliquen a la categoría.</div>
                <div class="alert alert-info" role="alert" invisible="step != 'delivery'">Elegí cómo se entregará el producto al comprador.</div>
                <div class="alert alert-warning" role="alert" invisible="step != 'attributes'">Completá las filas obligatorias. Usá la lupa cuando haya opciones disponibles.</div>
                <div class="alert alert-info" role="alert" invisible="step != 'variants_photos'">Agregá URLs públicas de imágenes adicionales si las necesitás.</div>
                <div class="alert alert-info" role="alert" invisible="step != 'review'">Validá los datos antes de publicar.</div>

                <group invisible="step != 'base'" string="Paso 1: Base - Configuración inicial">
                    <group>
                        <field name="ml_title" placeholder="Título que verá el comprador" required="1"/>
                    </group>
                    <group>
                        <div class="o_form_label">Categoría ML</div>
                        <div>
                            <field name="ml_category_ref_id" options="{'no_create': True}" nolabel="1" domain="[('account_id', '=', account_id)]"/>
                            <button name="action_open_category_search" type="object" string="Buscar categoría ML" class="btn-primary btn-sm"/>
                        </div>
                    </group>
                    <group>
                        <field name="listing_type_id" string="Tipo de publicación" required="1"/>
                        <field name="ml_condition" required="1"/>
                    </group>
                    <group string="Datos clave del producto (opcional)" col="2">
                        <field name="ml_brand" placeholder="Ej: Cerámica Alberdi"/>
                        <field name="ml_model" placeholder="Ej: Porcelanato 60x120"/>
                        <field name="ml_family_name" placeholder="Ej: Porcelanato, Azulejo, Sanitario"/>
                    </group>
                    <button name="action_load_ml_metadata" type="object" string="↓ Cargar atributos de la categoría" class="btn-info btn-block" visible="ml_category_ref_id"/>
                </group>

                <group invisible="step != 'pricing_stock'" string="Paso 2: Precio y Stock - Define valores económicos">
                    <group string="Precio" col="2">
                        <field name="ml_pricelist_id" string="Lista de precios"/>
                        <field name="ml_price_uom_id" string="UoM de venta"/>
                        <field name="ml_use_pricelist_price" string="Usar precio de lista"/>
                    </group>
                    <group col="2">
                        <field name="ml_manual_price_override" string="Usar precio personalizado"/>
                        <field name="ml_price" readonly="not ml_manual_price_override" string="Precio ML" required="1"/>
                    </group>
                    <group string="Stock" col="2">
                        <field name="ml_stock_reserve_qty" string="Reservado (no vender)"/>
                        <field name="ml_effective_qty" readonly="1" string="Stock a publicar"/>
                    </group>
                </group>

                <group invisible="step != 'sale_format'" string="Paso 3: Formato de venta - Unidades y rendimiento">
                    <group string="Unidad de venta" col="2">
                        <field name="ml_sales_unit_value_id" domain="[('account_id', '=', account_id), ('attribute_id', '=', 'SALES_UNIT')]" options="{'no_create': True}"/>
                    </group>
                    <group string="Rendimiento (si aplica)" col="2">
                        <field name="ml_yield_value" string="Cantidad"/>
                        <field name="ml_yield_unit" string="Unidad"/>
                    </group>
                </group>

                <group invisible="step != 'delivery'" string="Paso 4: Forma de entrega">
                    <group>
                        <field name="ml_shipping_mode" required="1"/>
                    </group>
                </group>

                <group invisible="step != 'attributes'" string="Paso 5: Atributos - Especificaciones del producto">
                    <field name="attribute_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" string="O." width="30px"/>
                            <field name="required" readonly="1" string="Oblig." width="50px"/>
                            <field name="attribute_name" readonly="1" string="Atributo"/>
                            <field name="attribute_option_id" options="{'no_create': True, 'no_open': True}" string="Opción" invisible="has_options == False" width="250px"/>
                            <field name="value_id" placeholder="ID opción ML" invisible="has_options == True" width="100px"/>
                            <field name="value_name" placeholder="Valor libre" invisible="has_options == True" width="150px"/>
                            <button name="action_open_attribute_option_picker" type="object" icon="fa-search" string="" title="Buscar opción para esta línea" class="btn btn-sm btn-secondary o_icon_button" invisible="has_options == False"/>
                        </list>
                    </field>
                </group>

                <group invisible="step != 'variants_photos'" string="Paso 6: Imágenes - Fotos del producto">
                    <field name="picture_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" string="O."/>
                            <field name="source" string="URL de imagen" placeholder="https://..."/>
                        </list>
                    </field>
                    <field name="ml_variant_notes" widget="text" placeholder="Notas sobre variantes (opcional)."/>
                </group>

                <group invisible="step != 'review'" string="Paso 7: Revisión - Checklist final">
                    <button name="action_validate_checklist" type="object" string="✓ Validar checklist" class="btn-secondary btn-block"/>
                    <field name="validation_summary" widget="text" readonly="1" placeholder="Se mostrará el estado final del producto y recomendaciones."/>
                </group>

                <footer>
                    <button name="action_prev" type="object" string="← Anterior" class="btn-secondary" invisible="step == 'base'"/>
                    <button name="action_next" type="object" string="Siguiente →" class="btn-primary"/>
                    <button name="action_apply_to_product" type="object" string="💾 Guardar" class="btn-secondary"/>
                    <button name="action_publish" type="object" string="🚀 Publicar en ML" class="btn-success" invisible="step != 'review'"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>