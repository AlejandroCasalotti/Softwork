<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_ml_product" model="ir.ui.view">
        <field name="name">product.template.form.ml.product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MercadoLibre">
                    <group string="Publicación" col="6">
                        <button name="action_open_ml_publish_assistant_wizard" type="object" string="Configurar publicación ML" class="btn-primary" invisible="marketplace_publication_id != False"/>
                        <button name="action_migrate_legacy_marketplace_data" type="object" string="Migrar datos legacy" class="btn-secondary"/>
                        <button name="action_modify_ml_listing" type="object" string="Modificar publicación en ML" class="btn-primary" invisible="not marketplace_publication_id"/>
                        <button name="action_open_ml_attribute_editor_wizard" type="object" string="Editar atributos" class="btn-secondary" invisible="marketplace_publication_id == False"/>
                        <button name="action_view_ml" type="object" string="Ver publicación" class="btn-link" invisible="not marketplace_publication_id"/>
                    </group>

                    <group>
                        <group string="Datos que se publican">
                            <field name="ml_publish_enabled"/>
                            <field name="ml_account_id"/>
                            <field name="ml_catalog_managed" readonly="1"/>
                            <field name="ml_title" readonly="ml_catalog_managed"/>
                            <field name="ml_category_id"/>
                            <field name="ml_condition"/>
                            <field name="ml_listing_type" readonly="1"/>
                        </group>

                        <group string="Precio y stock publicados">
                            <field name="ml_pricelist_id"/>
                            <field name="ml_price_uom_id"/>
                            <field name="ml_use_pricelist_price"/>
                            <field name="ml_manual_price_override"/>
                            <field name="ml_price" readonly="not ml_manual_price_override"/>
                            <field name="ml_stock_reserve_qty"/>
                        </group>
                    </group>

                    <group>
                        <group string="Datos del catálogo">
                            <field name="ml_brand"/>
                            <field name="ml_model"/>
                            <field name="ml_family_name_id"/>
                        </group>

                        <group string="Entrega y estado">
                            <field name="ml_shipping_mode"/>
                            <field name="marketplace_publication_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Descripción">
                        <field name="ml_description_html"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>