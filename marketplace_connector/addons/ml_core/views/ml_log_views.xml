<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ml_log_tree" model="ir.ui.view">
        <field name="name">ml.log.tree</field>
        <field name="model">ml.log</field>
        <field name="arch" type="xml">
            <list string="Logs MercadoLibre">
                <field name="create_date"/>
                <field name="account_id"/>
                <field name="level"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_ml_log_form" model="ir.ui.view">
        <field name="name">ml.log.form</field>
        <field name="model">ml.log</field>
        <field name="arch" type="xml">
            <form string="Log MercadoLibre">
                <sheet>
                    <group>
                        <field name="account_id"/>
                        <field name="level"/>
                        <field name="message"/>
                    </group>
                    <group>
                        <field name="detail" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ml_log" model="ir.actions.act_window">
        <field name="name">Logs MercadoLibre</field>
        <field name="res_model">ml.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>