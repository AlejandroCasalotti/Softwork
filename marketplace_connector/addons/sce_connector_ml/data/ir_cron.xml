<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_ml_sync_questions" model="ir.cron">
        <field name="name">SCE ML - Sincronizar preguntas nuevas a Discuss</field>
        <field name="model_id" ref="model_ml_question_channel"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_ml_questions()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_ml_check_question_replies" model="ir.cron">
        <field name="name">SCE ML - Revisar respuestas de Discuss y reenviar a ML</field>
        <field name="model_id" ref="model_ml_question_channel"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_ml_question_replies()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_ml_archive_answered_question_channels" model="ir.cron">
        <field name="name">SCE ML - Archivar canales de Discuss ya respondidos</field>
        <field name="model_id" ref="model_ml_question_channel"/>
        <field name="state">code</field>
        <field name="code">model.cron_archive_answered_ml_question_channels()</field>
        <field name="interval_number">3</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_ml_cleanup_question_channels" model="ir.cron">
        <field name="name">SCE ML - Limpiar canales de Discuss respondidos</field>
        <field name="model_id" ref="model_ml_question_channel"/>
        <field name="state">code</field>
        <field name="code">model.cron_cleanup_ml_question_channels()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
