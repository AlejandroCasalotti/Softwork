<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_account_form_product_diagnostics" model="ir.ui.view">
        <field name="name">sce.account.form.product.diagnostics</field>
        <field name="model">sce.account</field>
        <field name="inherit_id" ref="softwork_ecommerce_conector_base.view_sce_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Diagnóstico de productos" invisible="provider_type != 'mercadolibre'">
                    <group string="Acciones">
                        <button name="action_test_external_odoo_connection" type="object" string="Test conexión Odoo" class="btn-secondary"/>
                        <button name="action_test_external_mercadolibre_connection" type="object" string="Test conexión MercadoLibre" class="btn-secondary"/>
                        <button name="action_analyze_products" type="object" string="Analizar productos" class="btn-primary"/>
                    </group>
                    <group string="Odoo">
                        <field name="odoo_diagnostic_status" readonly="1"/>
                        <field name="odoo_diagnostic_at" readonly="1"/>
                        <field name="odoo_diagnostic_latency_ms" readonly="1"/>
                        <field name="odoo_diagnostic_products" readonly="1"/>
                        <field name="odoo_diagnostic_message" readonly="1"/>
                    </group>
                    <group string="MercadoLibre">
                        <field name="ml_diagnostic_status" readonly="1"/>
                        <field name="ml_diagnostic_at" readonly="1"/>
                        <field name="ml_diagnostic_latency_ms" readonly="1"/>
                        <field name="ml_diagnostic_publications" readonly="1"/>
                        <field name="ml_diagnostic_message" readonly="1"/>
                    </group>
                    <group string="Último análisis">
                        <field name="reconciliation_at" readonly="1"/>
                        <field name="reconciliation_latency_ms" readonly="1"/>
                        <field name="reconciliation_odoo_total" readonly="1"/>
                        <field name="reconciliation_odoo_with_sku" readonly="1"/>
                        <field name="reconciliation_odoo_without_sku" readonly="1"/>
                        <field name="reconciliation_ml_total" readonly="1"/>
                        <field name="reconciliation_ml_with_sku" readonly="1"/>
                        <field name="reconciliation_ml_without_sku" readonly="1"/>
                    </group>
                    <group string="Resultado">
                        <field name="reconciliation_match" readonly="1"/>
                        <field name="reconciliation_no_match" readonly="1"/>
                        <field name="reconciliation_conflict" readonly="1"/>
                        <field name="reconciliation_invalid" readonly="1"/>
                        <field name="reconciliation_error" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_sce_product_reconciliation_wizard_form" model="ir.ui.view">
        <field name="name">sce.product.reconciliation.wizard.form</field>
        <field name="model">sce.product.reconciliation.wizard</field>
        <field name="arch" type="xml">
            <form string="Análisis de productos" create="0" edit="0" delete="0">
                <group>
                    <field name="account_id"/>
                    <field name="status"/>
                    <field name="analyzed_at"/>
                    <field name="latency_ms"/>
                </group>
                <group string="Odoo">
                    <field name="odoo_total_products"/>
                    <field name="odoo_products_with_sku"/>
                    <field name="odoo_products_without_sku"/>
                </group>
                <group string="MercadoLibre">
                    <field name="ml_total_publications"/>
                    <field name="ml_publications_with_sku"/>
                    <field name="ml_publications_without_sku"/>
                </group>
                <group string="Reconciliación">
                    <field name="match_count"/>
                    <field name="no_match_count"/>
                    <field name="conflict_count"/>
                    <field name="invalid_count"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" edit="0" delete="0">
                        <field name="status" widget="badge"/>
                        <field name="sku"/>
                        <field name="odoo_product_id"/>
                        <field name="odoo_default_code"/>
                        <field name="mercadolibre_item_id"/>
                        <field name="mercadolibre_variation_id"/>
                        <field name="mercadolibre_sku"/>
                    </list>
                </field>
                <footer>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
