<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sce_global_settings_singleton" model="sce.global.settings">
        <field name="name">Configuración global SCE</field>
    </record>

    <record id="view_sce_global_settings_form" model="ir.ui.view">
        <field name="name">sce.global.settings.form</field>
        <field name="model">sce.global.settings</field>
        <field name="arch" type="xml">
            <form string="Configuración global SCE" create="0" delete="0">
                <header>
                    <button name="action_validate_keyring" type="object" string="Validar keyring" class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="singleton_key" invisible="1"/>
                    <div class="alert alert-success" role="alert" invisible="keyring_runtime_status != 'ready'">
                        <strong>Keyring operativo</strong>
                        <p class="mb-0"><field name="keyring_runtime_message" readonly="1" nolabel="1"/></p>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="keyring_runtime_status != 'missing'">
                        <strong>Falta keyring</strong>
                        <p class="mb-0"><field name="keyring_runtime_message" readonly="1" nolabel="1"/></p>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="keyring_runtime_status != 'invalid'">
                        <strong>Keyring inválido</strong>
                        <p class="mb-0"><field name="keyring_runtime_message" readonly="1" nolabel="1"/></p>
                    </div>
                    <group>
                        <group string="Seguridad SCE">
                            <field name="sce_core_keyring" password="True" readonly="keyring_runtime_source == 'environment'"/>
                            <field name="keyring_runtime_source" readonly="1"/>
                        </group>
                        <group string="Aplicación Mercado Libre">
                            <field name="mercadolibre_client_id"/>
                            <field name="mercadolibre_client_secret" password="True"/>
                            <field name="mercadolibre_redirect_uri"/>
                        </group>
                    </group>
                    <label string="Advertencia: guardar el keyring en base de datos es más práctico para Odoo.sh, pero menos seguro que una variable de entorno o un vault externo." class="text-warning"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sce_global_settings" model="ir.actions.act_window">
        <field name="name">SCE Settings</field>
        <field name="res_model">sce.global.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_sce_global_settings_form"/>
        <field name="res_id" ref="sce_global_settings_singleton"/>
        <field name="target">current</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <menuitem id="menu_sce_global_settings"
              name="SCE Settings"
              parent="softwork_ecommerce_conector_base.menu_sce_configuration"
              action="action_sce_global_settings"
              sequence="5"
              groups="base.group_system"/>
</odoo>
