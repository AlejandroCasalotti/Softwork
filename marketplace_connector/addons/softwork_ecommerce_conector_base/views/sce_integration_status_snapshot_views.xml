<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_integration_status_snapshot_tree" model="ir.ui.view">
        <field name="name">sce.integration.status.snapshot.tree</field>
        <field name="model">sce.integration.status.snapshot</field>
        <field name="arch" type="xml">
            <list string="Historial de Diagnósticos">
                <field name="executed_at"/>
                <field name="account_id"/>
                <field name="user_id"/>
                <field name="health_score"/>
                <field name="ok_count"/>
                <field name="warning_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <record id="view_sce_integration_status_snapshot_form" model="ir.ui.view">
        <field name="name">sce.integration.status.snapshot.form</field>
        <field name="model">sce.integration.status.snapshot</field>
        <field name="arch" type="xml">
            <form string="Snapshot Diagnóstico">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="company_id"/>
                            <field name="user_id"/>
                            <field name="executed_at"/>
                        </group>
                        <group>
                            <field name="health_score"/>
                            <field name="ok_count"/>
                            <field name="warning_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="test_name"/>
                            <field name="status"/>
                            <field name="message"/>
                            <field name="error_details"/>
                            <field name="action_type"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sce_integration_status_snapshot" model="ir.actions.act_window">
        <field name="name">Historial Diagnósticos</field>
        <field name="res_model">sce.integration.status.snapshot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>