<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_account_tree" model="ir.ui.view">
        <field name="name">sce.account.tree</field>
        <field name="model">sce.account</field>
        <field name="arch" type="xml">
            <list string="Cuentas Mercado Libre">
                <field name="name"/>
                <field name="external_user_id"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'" decoration-warning="state == 'draft'" decoration-danger="state == 'error'"/>
                <field name="last_sync"/>
            </list>
        </field>
    </record>

    <record id="view_sce_account_form" model="ir.ui.view">
        <field name="name">sce.account.form</field>
        <field name="model">sce.account</field>
        <field name="arch" type="xml">
            <form string="Mercado Libre">
                <header>
                    <button name="action_start_onboarding_connection" type="object" string="Conectar Mercado Libre" class="btn-primary" invisible="state == 'connected' or provider_type != 'mercadolibre'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error,disabled"/>
                </header>
                <sheet>
                    <field name="provider_type" invisible="1"/>
                    <field name="connector_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <div class="alert alert-info" role="alert" invisible="state == 'connected'">
                        <strong>Mercado Libre</strong>
                        <p class="mb-0">Conectá tu cuenta para comenzar a sincronizar productos, precios, stock y ventas.</p>
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'connected'">
                        <strong>✓ Cuenta conectada</strong>
                        <p class="mb-0">La cuenta está lista para sincronizar productos, precios, stock y ventas.</p>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error" readonly="1" nolabel="1"/>
                    </div>
                    <h1><field name="name" placeholder="Ej: Mi Tienda Argentina"/></h1>
                    <group>
                        <group string="Cuenta">
                            <field name="external_account_ref" readonly="1" string="Cuenta Mercado Libre" invisible="not external_account_ref"/>
                            <field name="external_user_id" readonly="1" string="Vendedor" invisible="not external_user_id"/>
                            <field name="state" readonly="1" string="Estado"/>
                        </group>
                        <group string="Sincronización">
                            <field name="last_sync" readonly="1" string="Última sincronización"/>
                            <field name="sync_orders"/>
                            <field name="sync_prices"/>
                            <field name="sync_stock"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sce_account" model="ir.actions.act_window">
        <field name="name">Cuentas Mercado Libre</field>
        <field name="res_model">sce.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('provider_type', '=', 'mercadolibre')]</field>
        <field name="context">{'default_provider_type': 'mercadolibre'}</field>
    </record>

    <record id="action_sce_ml_account" model="ir.actions.act_window">
        <field name="name">Mercado Libre</field>
        <field name="res_model">sce.account</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('provider_type', '=', 'mercadolibre')]</field>
        <field name="context">{'default_provider_type': 'mercadolibre', 'search_default_provider_type': 'mercadolibre'}</field>
    </record>
</odoo>
