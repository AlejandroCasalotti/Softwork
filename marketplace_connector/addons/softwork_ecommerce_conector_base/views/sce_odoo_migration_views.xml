<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_odoo_migration_run_tree" model="ir.ui.view">
        <field name="name">sce.odoo.migration.run.tree</field>
        <field name="model">sce.odoo.migration.run</field>
        <field name="arch" type="xml">
            <list string="Migraciones Odoo a Odoo">
                <field name="name"/>
                <field name="account_id"/>
                <field name="migration_mode"/>
                <field name="state"/>
                <field name="migrated_partners"/>
                <field name="migrated_products"/>
                <field name="migrated_taxes"/>
                <field name="migrated_sales"/>
                <field name="migrated_purchases"/>
                <field name="migrated_invoices"/>
                <field name="migrated_warehouses"/>
                <field name="migrated_locations"/>
                <field name="started_at"/>
                <field name="finished_at"/>
            </list>
        </field>
    </record>

    <record id="view_sce_odoo_migration_run_form" model="ir.ui.view">
        <field name="name">sce.odoo.migration.run.form</field>
        <field name="model">sce.odoo.migration.run</field>
        <field name="arch" type="xml">
            <form string="Migración Odoo a Odoo">
                <header>
                    <button name="action_detect_versions" type="object" string="Detectar versiones" class="btn-secondary"/>
                    <button name="action_analyze_fields" type="object" string="Analizar campos" class="btn-secondary" icon="fa-search"/>
                    <button name="action_reuse_previous_field_map" type="object" string="Reutilizar mapeo" class="btn-secondary" icon="fa-copy"/>
                    <button name="action_enqueue_migration" type="object" string="Ejecutar" class="btn-primary" invisible="state in ('queued', 'running')"/>
                    <button name="action_process_queued_migration" type="object" string="Procesar ahora" class="btn-primary" invisible="state != 'queued'"/>
                    <button name="action_pause_migration" type="object" string="Pausar" invisible="state != 'running'"/>
                    <button name="action_resume_migration" type="object" string="Reanudar" invisible="state not in ('paused','failed','draft')"/>
                    <button name="action_reset_checkpoint" type="object" string="Reset checkpoint" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,queued,running,paused,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id" domain="[('provider_type', '=', 'odoo')]"/>
                            <field name="company_id" readonly="1"/>
                            <field name="migration_mode"/>
                            <field name="since_datetime" invisible="migration_mode != 'incremental'"/>
                            <field name="batch_size"/>
                            <field name="continue_on_error"/>
                            <label for="account_id"/>
                            <div class="o_row">
                                <button name="%(action_sce_account)d" type="action" string="Configurar cuenta Odoo Origen/Destino" class="btn-link"/>
                            </div>
                        </group>
                        <group>
                            <field name="source_version" readonly="1"/>
                            <field name="target_version" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="finished_at" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>

                    <group string="Módulos de migración">
                        <group>
                            <field name="sync_partners"/>
                            <field name="sync_products"/>
                            <field name="sync_taxes"/>
                            <field name="sync_product_categories"/>
                            <field name="sync_product_web_categories"/>
                            <field name="sync_product_suppliers"/>
                            <field name="sync_sales"/>
                            <field name="sync_purchases"/>
                            <field name="sync_invoices"/>
                            <field name="sync_payments"/>
                            <field name="sync_documents"/>
                            <field name="sync_stock_warehouses"/>
                            <field name="sync_stock_locations"/>
                        </group>
                        <group>
                            <field name="migrated_partners" readonly="1"/>
                            <field name="migrated_products" readonly="1"/>
                            <field name="migrated_taxes" readonly="1"/>
                            <field name="migrated_product_categories" readonly="1"/>
                            <field name="migrated_product_web_categories" readonly="1"/>
                            <field name="migrated_product_suppliers" readonly="1"/>
                            <field name="migrated_sales" readonly="1"/>
                            <field name="migrated_purchases" readonly="1"/>
                            <field name="migrated_invoices" readonly="1"/>
                            <field name="migrated_payments" readonly="1"/>
                            <field name="migrated_documents" readonly="1"/>
                            <field name="migrated_warehouses" readonly="1"/>
                            <field name="migrated_locations" readonly="1"/>
                        </group>
                    </group>

                    <group string="Control / resultados">
                        <group>
                            <field name="checkpoint_json" widget="text"/>
                        </group>
                        <group>
                            <field name="result_json" widget="text" readonly="1"/>
                            <field name="last_error" widget="text" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Mapeo de campos" name="page_field_map">
                            <div class="alert alert-info" role="status" invisible="field_map_count != 0">
                                Presioná <b>Analizar campos</b> para que SCE consulte el Odoo origen y destino
                                y arme el mapeo. Después vas a poder desmarcar los campos que no quieras migrar.
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2" invisible="field_map_count == 0">
                                <button name="action_field_map_select_recommended" type="object"
                                        string="Seleccionar recomendados" class="btn-secondary btn-sm"/>
                                <button name="action_field_map_select_basic" type="object"
                                        string="Solo campos básicos" class="btn-secondary btn-sm"/>
                                <button name="action_field_map_select_none" type="object"
                                        string="Deseleccionar todos" class="btn-secondary btn-sm"/>
                                <span class="ms-3 text-muted">
                                    <field name="field_map_selected_count" readonly="1" nolabel="1" class="oe_inline"/>
                                    de
                                    <field name="field_map_count" readonly="1" nolabel="1" class="oe_inline"/>
                                    campos seleccionados
                                </span>
                            </div>
                            <field name="field_map_ids" nolabel="1">
                                <list editable="bottom" default_order="model_name,sequence,field_label"
                                      decoration-muted="compatibility in ('missing_target','readonly','lines')"
                                      decoration-bf="is_required">
                                    <field name="model_label" readonly="1" optional="show"/>
                                    <field name="field_label" readonly="1"/>
                                    <field name="source_field" readonly="1" optional="show"/>
                                    <field name="field_type" readonly="1" optional="hide"/>
                                    <field name="relation_model" readonly="1" optional="hide"/>
                                    <field name="compatibility" readonly="1" widget="badge"
                                           decoration-success="compatibility == 'ok'"
                                           decoration-info="compatibility == 'relation'"
                                           decoration-warning="compatibility in ('required','readonly')"
                                           decoration-danger="compatibility in ('missing_target','lines')"/>
                                    <field name="is_required" readonly="1" optional="hide"/>
                                    <field name="migrate" readonly="compatibility in ('missing_target','readonly','lines')"/>
                                    <field name="model_name" column_invisible="1"/>
                                    <field name="sequence" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sce_odoo_migration_run" model="ir.actions.act_window">
        <field name="name">Migraciones Odoo a Odoo</field>
        <field name="res_model">sce.odoo.migration.run</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_sce_odoo_migration_wizard_form" model="ir.ui.view">
        <field name="name">sce.odoo.migration.wizard.form</field>
        <field name="model">sce.odoo.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Asistente de migración Odoo a Odoo">
                <group>
                    <field name="account_id" domain="[('provider_type', '=', 'odoo')]"/>
                    <field name="migration_mode"/>
                    <field name="since_datetime" invisible="migration_mode != 'incremental'"/>
                </group>
                <group>
                    <label for="account_id"/>
                    <div class="o_row">
                        <button name="%(action_sce_account)d" type="action" string="Ir a Accounts para cargar Origen y Destino" class="btn-link"/>
                    </div>
                </group>
                <group string="Módulos">
                    <field name="sync_partners"/>
                    <field name="sync_products"/>
                    <field name="sync_taxes"/>
                    <field name="sync_product_categories"/>
                    <field name="sync_product_web_categories"/>
                    <field name="sync_product_suppliers"/>
                    <field name="sync_sales"/>
                    <field name="sync_purchases"/>
                    <field name="sync_invoices"/>
                    <field name="sync_payments"/>
                    <field name="sync_documents"/>
                    <field name="sync_stock_warehouses"/>
                    <field name="sync_stock_locations"/>
                </group>
                <footer>
                    <button name="action_start" type="object" string="Iniciar migración" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>