<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sce_log_tree" model="ir.ui.view">
        <field name="name">sce.log.tree</field>
        <field name="model">sce.log</field>
        <field name="arch" type="xml">
            <list string="Logs">
                <field name="create_date"/>
                <field name="level"/>
                <field name="name"/>
                <field name="connector_id"/>
                <field name="account_id"/>
                <field name="job_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_sce_log_form" model="ir.ui.view">
        <field name="name">sce.log.form</field>
        <field name="model">sce.log</field>
        <field name="arch" type="xml">
            <form string="Log">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="level" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="connector_id" readonly="1"/>
                            <field name="account_id" readonly="1"/>
                            <field name="job_id" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="message" readonly="1" widget="text"/>
                    </group>
                    <group>
                        <field name="details_json" readonly="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sce_log" model="ir.actions.act_window">
        <field name="name">Logs</field>
        <field name="res_model">sce.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>