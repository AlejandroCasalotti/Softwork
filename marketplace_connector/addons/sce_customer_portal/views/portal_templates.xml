<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sce_dashboard" name="SCE Subscription Dashboard">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <t t-if="subscription">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="h3 mb-1">Mis Integraciones</h1>
                            <p class="text-muted mb-0">Conectá tus canales de venta y controlá la sincronización</p>
                        </div>
                        <span class="badge rounded-pill text-bg-success" t-if="subscription.state == 'active'">Activa</span>
                        <span class="badge rounded-pill text-bg-info" t-elif="subscription.state == 'trial'">Prueba gratuita</span>
                        <span class="badge rounded-pill text-bg-warning" t-else=""><t t-esc="subscription.state"/></span>
                    </div>
                    <div class="alert alert-success" role="status" t-if="notice"><t t-esc="notice"/></div>
                    <div class="alert alert-danger" role="alert" t-if="error"><t t-esc="error"/></div>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted small">Plan actual</div>
                                    <div class="h4 mb-1"><t t-esc="subscription.plan_id.name"/></div>
                                    <div class="text-muted">Desde <t t-esc="subscription.start_date"/></div>
                                    <div class="text-muted" t-if="subscription.state == 'trial'">Prueba gratuita hasta <t t-esc="subscription.trial_end_date"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted small">Productos sincronizados</div>
                                    <div class="h4 mb-1"><t t-esc="total_products"/></div>
                                    <div class="text-muted">Publicaciones activas conectadas a SCE</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body">
                                    <div class="text-muted small">Próximo período</div>
                                    <div class="h5 mb-1"><t t-esc="subscription.period_start"/> - <t t-esc="subscription.period_end"/></div>
                                    <a class="btn btn-outline-secondary btn-sm mt-2" href="/my/sce/rules">Reglas de sincronización</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Seleccioná qué cuenta deseás conectar</h2>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <form action="/my/sce/connect/mercadolibre" method="post" class="h-100">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <button type="submit" class="btn btn-light border w-100 h-100 py-3">
                                        <div class="fw-semibold">Mercado Libre</div>
                                        <div class="text-muted small">Conectar nueva cuenta</div>
                                        </button>
                                    </form>
                                </div>
                                <div class="col-md-3"><button class="btn btn-light border w-100 h-100 py-3" disabled="disabled"><div class="fw-semibold">TiendaNube</div><div class="text-muted small">Próximamente</div></button></div>
                                <div class="col-md-3"><button class="btn btn-light border w-100 h-100 py-3" disabled="disabled"><div class="fw-semibold">Shopify</div><div class="text-muted small">Próximamente</div></button></div>
                                <div class="col-md-3"><button class="btn btn-light border w-100 h-100 py-3" disabled="disabled"><div class="fw-semibold">WooCommerce</div><div class="text-muted small">Próximamente</div></button></div>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm mb-4" t-if="ml_accounts">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Cuentas Mercado Libre</h2>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead><tr><th>Cuenta</th><th>Estado</th><th>Usuario ML</th><th>Sincronización</th><th/></tr></thead>
                                    <tbody>
                                        <tr t-foreach="ml_accounts" t-as="ml_account">
                                            <td><t t-esc="ml_account.name"/></td>
                                            <td><span class="badge text-bg-success" t-if="ml_account.state == 'connected'">Conectada</span><span class="badge text-bg-danger" t-elif="ml_account.state == 'error'">Error</span><span class="badge text-bg-warning" t-else=""><t t-esc="ml_account.state"/></span></td>
                                            <td><t t-esc="ml_account.ml_nickname or ml_account.external_user_id or '-'"/></td>
                                            <td>
                                                <span class="badge text-bg-secondary" t-if="ml_account.sync_paused">Pausada</span>
                                                <span class="badge text-bg-danger" t-elif="ml_account.jobs_stale_count">Atención: trabajo detenido</span>
                                                <span class="badge text-bg-success" t-elif="ml_account.jobs_pending_count">En marcha</span>
                                                <span class="badge text-bg-warning" t-elif="ml_account.jobs_failed_count">Requiere atención</span>
                                                <span class="badge text-bg-success" t-elif="ml_account.jobs_done_count">Lista</span>
                                                <span class="badge text-bg-warning" t-else="">Pendiente</span>
                                                <div class="small text-muted mt-1"><t t-esc="ml_account.jobs_done_count"/> completados · <t t-esc="ml_account.jobs_failed_count"/> fallidos o parciales</div>
                                                <div class="small text-danger mt-1" t-if="ml_account.jobs_stale_count"><t t-esc="ml_account.jobs_stale_count"/> trabajo(s) detenidos; el sistema los recuperará automáticamente.</div>
                                                <ul class="small text-muted mt-1 mb-0" t-if="jobs_attention.get(ml_account.id)">
                                                    <li t-foreach="jobs_attention.get(ml_account.id)" t-as="attention_job">
                                                        <t t-esc="attention_job.job_type"/> — <t t-esc="attention_job.state"/> (intento <t t-esc="attention_job.attempts"/>)
                                                    </li>
                                                </ul>
                                                <div class="small text-danger mt-1" t-if="ml_account.last_error"><t t-esc="ml_account.last_error"/></div>
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-primary" t-att-href="'/my/sce/rules/%s' % ml_account.id">Reglas</a>
                                                <a class="btn btn-sm btn-outline-warning" t-if="ml_account.state == 'error'" t-att-href="'/sce/oauth/mercadolibre/start?account_id=%s' % ml_account.id">Reautorizar</a>
                                                <a class="btn btn-sm btn-outline-primary" t-if="ml_account.state == 'disabled'" t-att-href="'/sce/oauth/mercadolibre/start?account_id=%s' % ml_account.id">Conectar de nuevo</a>
                                                <form t-attf-action="/my/sce/account/#{ml_account.id}/sync/start" method="post" class="d-inline">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-sm btn-primary" t-att-disabled="'disabled' if ml_account.sync_paused or ml_account.state != 'connected' else None">Sincronizar</button>
                                                </form>
                                                <form t-attf-action="/my/sce/account/#{ml_account.id}/sync/pause" method="post" class="d-inline">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" t-att-disabled="'disabled' if ml_account.sync_paused or ml_account.state != 'connected' else None">Pausar</button>
                                                </form>
                                                <form t-attf-action="/my/sce/account/#{ml_account.id}/sync/resume" method="post" class="d-inline">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-success" t-att-disabled="'disabled' if not ml_account.sync_paused or ml_account.state != 'connected' else None">Reanudar</button>
                                                </form>
                                                <form t-attf-action="/my/sce/account/#{ml_account.id}/sync/retry" method="post" class="d-inline" t-if="ml_account.jobs_failed_count">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" t-att-disabled="'disabled' if ml_account.sync_paused or ml_account.state != 'connected' else None">Reintentar fallidos</button>
                                                </form>
                                                <form t-attf-action="/my/sce/account/#{ml_account.id}/sync/disconnect" method="post" class="d-inline" t-if="ml_account.state != 'disabled'" onsubmit="return confirm('La cuenta se pausará y se eliminarán los tokens y claves guardados. Los datos ya sincronizados no se borrarán. ¿Continuar?');">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Desconectar y borrar credenciales</button>
                                                </form>
                                                <details class="text-start mt-2">
                                                    <summary class="btn btn-sm btn-outline-secondary">Configurar Odoo de esta cuenta</summary>
                                                    <form t-attf-action="/my/sce/account/#{ml_account.id}/odoo" method="post" class="row g-2 mt-1">
                                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                        <div class="col-12"><label class="form-label">URL de Odoo</label><input class="form-control" name="odoo_base_url" t-att-value="ml_account.odoo_base_url or ''" placeholder="https://tu-odoo.com" required="required"/></div>
                                                        <div class="col-12"><label class="form-label">Base de datos</label><input class="form-control" name="odoo_db_name" t-att-value="ml_account.odoo_db_name or ''" required="required"/></div>
                                                        <div class="col-12"><label class="form-label">Usuario</label><input class="form-control" name="odoo_user" t-att-value="ml_account.odoo_user or ''" required="required"/></div>
                                                        <div class="col-12"><label class="form-label">API key / contraseña</label><input type="password" class="form-control" name="odoo_password" autocomplete="new-password" t-att-required="'required' if not ml_account.odoo_password else None" placeholder="Dejar vacío para conservar la clave"/></div>
                                                        <div class="col-12 form-check"><input class="form-check-input" type="checkbox" name="sync_stock" t-att-checked="'checked' if ml_account.sync_stock else None"/><label class="form-check-label">Sincronizar stock</label></div>
                                                        <div class="col-12 form-check"><input class="form-check-input" type="checkbox" name="sync_prices" t-att-checked="'checked' if ml_account.sync_prices else None"/><label class="form-check-label">Sincronizar precios</label></div>
                                                        <div class="col-12 form-check"><input class="form-check-input" type="checkbox" name="sync_orders" t-att-checked="'checked' if ml_account.sync_orders else None"/><label class="form-check-label">Sincronizar ventas</label></div>
                                                        <div class="col-12"><button type="submit" class="btn btn-sm btn-primary">Guardar y probar conexión</button></div>
                                                    </form>
                                                </details>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <t t-set="latest" t-value="summaries[:1]"/>
                    <t t-if="latest">
                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body">
                                <h2 class="h5 mb-3">Uso del período anterior</h2>
                                <div class="row g-4">
                                    <div class="col-md-6">
                                        <div class="d-flex justify-content-between"><span>Ventas sincronizadas</span><strong><t t-esc="latest[0].orders_count"/> / <t t-esc="latest[0].plan_id.max_monthly_orders"/></strong></div>
                                        <div class="progress mt-2" style="height: 8px"><div class="progress-bar" role="progressbar" t-att-style="'width: %s%%' % min(100, latest[0].orders_count * 100 / max(1, latest[0].plan_id.max_monthly_orders))"/></div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="d-flex justify-content-between"><span>Publicaciones / SKU</span><strong><t t-esc="latest[0].products_count"/> / <t t-esc="latest[0].plan_id.max_synced_products"/></strong></div>
                                        <div class="progress mt-2" style="height: 8px"><div class="progress-bar" role="progressbar" t-att-style="'width: %s%%' % min(100, latest[0].products_count * 100 / max(1, latest[0].plan_id.max_synced_products))"/></div>
                                    </div>
                                </div>
                                <div class="mt-4"><span class="text-muted">Importe estimado:</span> <strong><t t-esc="latest[0].amount_company_currency"/> <t t-esc="latest[0].company_currency_id.symbol"/></strong></div>
                            </div>
                        </div>
                    </t>
                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5">Historial de uso</h2>
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead><tr><th>Período</th><th>Ventas</th><th>Publicaciones</th><th>Importe</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="summaries" t-as="summary">
                                            <td><t t-esc="summary.period_start"/> - <t t-esc="summary.period_end"/></td>
                                            <td><t t-esc="summary.orders_count"/></td>
                                            <td><t t-esc="summary.products_count"/></td>
                                            <td><t t-esc="summary.amount_company_currency"/> <t t-esc="summary.company_currency_id.symbol"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center py-5">
                    <h1 class="h3">Conectá tu cuenta SCE</h1>
                    <p class="text-muted">Todavía no hay una suscripción asociada a tu empresa.</p>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
