<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sce_rules" name="SCE Reglas de sincronización">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <t t-if="notice">
                    <div class="alert alert-success"><t t-esc="notice"/></div>
                </t>
                <t t-if="account">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="h3 mb-0">Reglas de sincronización</h1>
                        <a class="btn btn-outline-secondary btn-sm" href="/my/sce">Volver a mi suscripción</a>
                    </div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Stock y precios</h2>
                            <form action="/my/sce/rules/save" method="post" class="row g-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="col-md-4">
                                    <label class="form-label">Stock de seguridad</label>
                                    <input class="form-control" type="number" name="safety_stock" t-att-value="account.safety_stock"/>
                                </div>
                                <div class="col-md-4 form-check mt-4">
                                    <input class="form-check-input" type="checkbox" name="sync_stock_flex" t-att-checked="'checked' if account.sync_stock_flex else None"/>
                                    <label class="form-check-label">Stock flexible</label>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Factor de seguridad de precio (%)</label>
                                    <input class="form-control" type="number" step="0.01" name="price_security_factor" t-att-value="account.price_security_factor"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Recargo fijo ($)</label>
                                    <input class="form-control" type="number" step="0.01" name="price_surcharge_fixed" t-att-value="account.price_surcharge_fixed"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Recargo porcentual (%)</label>
                                    <input class="form-control" type="number" step="0.01" name="price_surcharge_percent" t-att-value="account.price_surcharge_percent"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Umbral envío gratis ($)</label>
                                    <input class="form-control" type="number" step="0.01" name="free_shipping_threshold" t-att-value="account.free_shipping_threshold"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Costo envío bajo umbral ($)</label>
                                    <input class="form-control" type="number" step="0.01" name="free_shipping_fee" t-att-value="account.free_shipping_fee"/>
                                </div>
                                <div class="col-12"><button type="submit" class="btn btn-primary">Guardar</button></div>
                            </form>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Reglas de cuotas</h2>
                            <div class="table-responsive mb-3">
                                <table class="table align-middle">
                                    <thead><tr><th>Nombre</th><th>Cuotas</th><th>Sin interés</th><th>Cualquier cantidad</th><th>Recargo %</th><th/></tr></thead>
                                    <tbody>
                                        <tr t-foreach="installment_rules" t-as="rule">
                                            <td><t t-esc="rule.name"/></td>
                                            <td><t t-esc="rule.installments_qty"/></td>
                                            <td><t t-esc="'Sí' if rule.no_interest else 'No'"/></td>
                                            <td><t t-esc="'Sí' if rule.applies_to_any_qty else 'No'"/></td>
                                            <td><t t-esc="rule.surcharge_percent"/></td>
                                            <td>
                                                <form t-attf-action="/my/sce/rules/installment/delete/#{rule.id}" method="post" class="d-inline">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                                </form>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <form action="/my/sce/rules/installment/add" method="post" class="row g-2">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="col-md-3"><input class="form-control" name="name" placeholder="Nombre" required="required"/></div>
                                <div class="col-md-2"><input class="form-control" type="number" name="installments_qty" placeholder="Cuotas"/></div>
                                <div class="col-md-2 form-check mt-2"><input class="form-check-input" type="checkbox" name="no_interest"/><label class="form-check-label">Sin interés</label></div>
                                <div class="col-md-2 form-check mt-2"><input class="form-check-input" type="checkbox" name="applies_to_any_qty"/><label class="form-check-label">Cualquier cantidad</label></div>
                                <div class="col-md-2"><input class="form-control" type="number" step="0.01" name="surcharge_percent" placeholder="Recargo %"/></div>
                                <div class="col-md-1"><button type="submit" class="btn btn-primary">Agregar</button></div>
                            </form>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center py-5">
                        <h1 class="h3">Conectá tu cuenta de Mercado Libre primero</h1>
                        <a class="btn btn-primary mt-2" href="/my/sce">Ir a mi suscripción</a>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
