<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_sce_rules" name="SCE Reglas de sincronización">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <t t-if="notice">
                    <div class="alert alert-success"><t t-esc="notice"/></div>
                </t>
                <t t-if="account">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h1 class="h3 mb-0">Reglas de sincronización</h1>
                            <p class="text-muted mb-0"><t t-esc="account.name"/> <t t-if="account.ml_nickname">- <t t-esc="account.ml_nickname"/></t></p>
                        </div>
                        <a class="btn btn-outline-secondary btn-sm" href="/my/sce">Volver a mi suscripción</a>
                    </div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Stock y precios</h2>
                            <div id="sce_remote_options_notice" class="alert d-none" role="status"/>
                            <form id="sce_rules_form" action="/my/sce/rules/save" method="post" class="row g-3">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="account_id" t-att-value="account.id"/>
                                <div class="col-md-4">
                                    <label class="form-label">Stock de seguridad</label>
                                    <input class="form-control" type="number" name="safety_stock" t-att-value="account.safety_stock"/>
                                </div>
                                <div class="col-md-4 form-check mt-4">
                                    <input class="form-check-input" type="checkbox" name="sync_stock_flex" t-att-checked="'checked' if account.sync_stock_flex else None"/>
                                    <label class="form-check-label">Stock flexible</label>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Factor de seguridad de precio (%)</label>
                                    <input class="form-control" type="number" step="0.01" name="price_security_factor" t-att-value="account.price_security_factor"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Recargo fijo ($)</label>
                                    <input class="form-control" type="number" step="0.01" name="price_surcharge_fixed" t-att-value="account.price_surcharge_fixed"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Recargo porcentual (%)</label>
                                    <input class="form-control" type="number" step="0.01" name="price_surcharge_percent" t-att-value="account.price_surcharge_percent"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Umbral envío gratis ($)</label>
                                    <input class="form-control" type="number" step="0.01" name="free_shipping_threshold" t-att-value="account.free_shipping_threshold"/>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Costo envío bajo umbral ($)</label>
                                    <input class="form-control" type="number" step="0.01" name="free_shipping_fee" t-att-value="account.free_shipping_fee"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Empresa de Odoo</label>
                                    <div class="input-group">
                                        <input id="sce_odoo_company" class="form-control" name="odoo_company_name" t-att-value="account.odoo_company_name"/>
                                        <button type="button" class="btn btn-outline-secondary js_sce_remote_options" data-option-type="companies" data-target="sce_odoo_company" title="Ver empresas disponibles"><i class="fa fa-search"/></button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Depósito de stock</label>
                                    <div class="input-group">
                                        <input id="sce_stock_location" class="form-control" name="stock_location_name" t-att-value="account.stock_location_name"/>
                                        <button type="button" class="btn btn-outline-secondary js_sce_remote_options" data-option-type="stock_locations" data-target="sce_stock_location" title="Ver depósitos disponibles"><i class="fa fa-search"/></button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Lista de precios</label>
                                    <div class="input-group">
                                        <input id="sce_pricelist" class="form-control" name="pricelist_name" t-att-value="account.pricelist_name"/>
                                        <button type="button" class="btn btn-outline-secondary js_sce_remote_options" data-option-type="pricelists" data-target="sce_pricelist" title="Ver listas disponibles"><i class="fa fa-search"/></button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Equipo de ventas</label>
                                    <div class="input-group">
                                        <input id="sce_sales_team" class="form-control" name="sales_team_name" t-att-value="account.sales_team_name"/>
                                        <button type="button" class="btn btn-outline-secondary js_sce_remote_options" data-option-type="sales_teams" data-target="sce_sales_team" title="Ver equipos disponibles"><i class="fa fa-search"/></button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Almacén estándar</label>
                                    <div class="input-group">
                                        <input id="sce_warehouse" class="form-control" name="warehouse_name" t-att-value="account.warehouse_name"/>
                                        <button type="button" class="btn btn-outline-secondary js_sce_remote_options" data-option-type="warehouses" data-target="sce_warehouse" title="Ver almacenes disponibles"><i class="fa fa-search"/></button>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Almacén FULL</label>
                                    <div class="input-group">
                                        <input id="sce_fulfillment_warehouse" class="form-control" name="fulfillment_warehouse_name" t-att-value="account.fulfillment_warehouse_name"/>
                                        <button type="button" class="btn btn-outline-secondary js_sce_remote_options" data-option-type="warehouses" data-target="sce_fulfillment_warehouse" title="Ver almacenes disponibles"><i class="fa fa-search"/></button>
                                    </div>
                                </div>
                                <div class="col-12"><hr/><h3 class="h6">Ventas y preguntas</h3></div>
                                <div class="col-md-4 form-check ms-2"><input class="form-check-input" type="checkbox" name="sync_orders_full" t-att-checked="'checked' if account.sync_orders_full else None"/><label class="form-check-label">Sincronizar ventas FULL</label></div>
                                <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="marketplace_auto_confirm_paid" t-att-checked="'checked' if account.marketplace_auto_confirm_paid else None"/><label class="form-check-label">Confirmar ventas pagadas</label></div>
                                <div class="col-md-4 form-check"><input class="form-check-input" type="checkbox" name="marketplace_auto_cancelled" t-att-checked="'checked' if account.marketplace_auto_cancelled else None"/><label class="form-check-label">Cancelar ventas canceladas</label></div>
                                <div class="col-md-6 form-check ms-2"><input class="form-check-input" type="checkbox" name="sync_ml_questions" t-att-checked="'checked' if account.sync_ml_questions else None"/><label class="form-check-label">Enviar preguntas de ML al Discuss de Odoo</label></div>
                                <div class="col-md-5"><label class="form-label">Días de retención de canales</label><input class="form-control" type="number" min="1" name="ml_question_retention_days" t-att-value="account.ml_question_retention_days"/></div>
                                <div class="col-12"><button type="submit" class="btn btn-primary">Guardar</button></div>
                            </form>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Reglas de cuotas</h2>
                            <p class="text-muted small">Usamos las modalidades típicas de Mercado Libre. Solo ajustá el recargo que querés aplicar.</p>
                            <div class="table-responsive mb-3">
                                <table class="table align-middle">
                                    <thead><tr><th>Modalidad</th><th>Cuotas</th><th>Tipo</th><th>Recargo %</th></tr></thead>
                                    <tbody>
                                        <tr t-foreach="installment_rules" t-as="rule">
                                            <td><t t-esc="rule.name"/></td>
                                            <td><t t-esc="'Cualquiera' if rule.applies_to_any_qty else rule.installments_qty"/></td>
                                            <td><t t-esc="'Sin interés' if rule.no_interest else 'Con interés'"/></td>
                                            <td><input class="form-control form-control-sm" type="number" step="0.01" t-att-name="'surcharge_%s' % rule.id" t-att-value="rule.surcharge_percent" form="sce_rules_form"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <form action="/my/sce/rules/installment/restore" method="post">
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <input type="hidden" name="account_id" t-att-value="account.id"/>
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Restaurar reglas sugeridas</button>
                            </form>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="text-center py-5">
                        <h1 class="h3">Conectá tu cuenta de Mercado Libre primero</h1>
                        <a class="btn btn-primary mt-2" href="/my/sce">Ir a mi suscripción</a>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
