<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ===================================================== -->
    <!-- Job Failed -->
    <!-- ===================================================== -->

    <record id="mail_template_sce_job_failed"
            model="mail.template">

        <field name="name">SCE - Job Failed</field>

        <field name="model_id"
               ref="model_sce_job"/>

        <field name="subject">
[SCE] Synchronization failed - ${object.name}
        </field>

        <field name="email_from">
{{ user.email_formatted }}
        </field>

        <field name="auto_delete"
               eval="True"/>

        <field name="body_html"
               type="html"><![CDATA[

<div style="font-family:Arial,sans-serif;font-size:14px;">

<h2 style="color:#C0392B;">
Softwork Commerce Engine
</h2>

<p>

A synchronization job has failed.

</p>

<hr/>

<table cellpadding="6">

<tr>
<td><strong>Job</strong></td>
<td>${object.name}</td>
</tr>

<tr>
<td><strong>Status</strong></td>
<td>${object.state}</td>
</tr>

<tr>
<td><strong>Connector</strong></td>
<td>${object.connector_id.display_name or ''}</td>
</tr>

<tr>
<td><strong>Account</strong></td>
<td>${object.account_id.display_name or ''}</td>
</tr>

<tr>
<td><strong>Started</strong></td>
<td>${object.started_at or ''}</td>
</tr>

<tr>
<td><strong>Finished</strong></td>
<td>${object.finished_at or ''}</td>
</tr>

<tr>
<td><strong>Error</strong></td>
<td>${object.error_message or object.error or ''}</td>
</tr>

</table>

<hr/>

<p style="color:#888;">

Generated automatically by
<strong>Softwork Commerce Engine</strong>.

</p>

</div>

]]></field>

    </record>

    <!-- ===================================================== -->
    <!-- OAuth Expired -->
    <!-- ===================================================== -->

    <record id="mail_template_sce_account_expired"
            model="mail.template">

        <field name="name">
SCE - OAuth Expired
        </field>

        <field name="model_id"
               ref="model_sce_account"/>

        <field name="subject">
[SCE] Marketplace authorization expired
        </field>

        <field name="email_from">
{{ user.email_formatted }}
        </field>

        <field name="auto_delete"
               eval="True"/>

        <field name="body_html"
               type="html"><![CDATA[

<div style="font-family:Arial,sans-serif;">

<h2 style="color:#E67E22;">
Marketplace authentication expired
</h2>

<p>

The account

<strong>${object.name}</strong>

requires a new authorization.

</p>

<p>

Please reconnect this account from
Softwork Commerce Engine.

</p>

<hr/>

<p style="color:#888;">

Generated automatically by
<strong>Softwork Commerce Engine</strong>.

</p>

</div>

]]></field>

    </record>

    <!-- ===================================================== -->
    <!-- Connector Error -->
    <!-- ===================================================== -->

    <record id="mail_template_sce_connector_error"
            model="mail.template">

        <field name="name">
SCE - Connector Error
        </field>

        <field name="model_id"
               ref="model_sce_log"/>

        <field name="subject">
[SCE] Connector Error
        </field>

        <field name="email_from">
{{ user.email_formatted }}
        </field>

        <field name="auto_delete"
               eval="True"/>

        <field name="body_html"
               type="html"><![CDATA[

<div style="font-family:Arial,sans-serif;">

<h2 style="color:#C0392B;">
Connector Error
</h2>

<p>

An integration error has been detected.

</p>

<table cellpadding="6">

<tr>
<td><strong>Category</strong></td>
<td>${object.category}</td>
</tr>

<tr>
<td><strong>Level</strong></td>
<td>${object.level}</td>
</tr>

<tr>
<td><strong>Message</strong></td>
<td>${object.message}</td>
</tr>

</table>

<hr/>

<p style="color:#888;">
Generated automatically by
<strong>Softwork Commerce Engine</strong>.
</p>

</div>

]]></field>

    </record>

    <!-- ===================================================== -->
    <!-- System Alert -->
    <!-- ===================================================== -->

    <record id="mail_template_sce_system_alert"
            model="mail.template">

        <field name="name">
SCE - System Alert
        </field>

        <field name="model_id"
               ref="model_sce_log"/>

        <field name="subject">
[SCE] Critical System Alert
        </field>

        <field name="email_from">
{{ user.email_formatted }}
        </field>

        <field name="auto_delete"
               eval="True"/>

        <field name="body_html"
               type="html"><![CDATA[

<div style="font-family:Arial,sans-serif;">

<h2 style="color:#C0392B;">
Critical System Alert
</h2>

<p>

A critical event has occurred inside
Softwork Commerce Engine.

</p>

<p>

Please review the logs immediately.

</p>

<hr/>

<p style="color:#888;">
Generated automatically by
<strong>Softwork Commerce Engine</strong>.
</p>

</div>

]]></field>

    </record>

</data>
</odoo>