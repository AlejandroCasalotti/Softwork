<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ========================================================= -->
    <!-- Queue Processor -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_queue_processor" model="ir.cron">

        <field name="name">[SCE] Process Queue</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">minutes</field>

        <field name="priority">5</field>

        <field name="state">code</field>

        <field name="code">
env["sce.queue.service"].process_pending()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Retry Failed Jobs -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_retry_jobs" model="ir.cron">

        <field name="name">[SCE] Retry Failed Jobs</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">15</field>

        <field name="interval_type">minutes</field>


        <field name="priority">10</field>

        <field name="state">code</field>

        <field name="code">
env["sce.job.service"].retry_failed_jobs()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Cache Cleanup -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_cache_cleanup" model="ir.cron">

        <field name="name">[SCE] Cleanup Cache</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">hours</field>


        <field name="priority">20</field>

        <field name="state">code</field>

        <field name="code">
env["sce.cache.service"].cleanup()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Log Cleanup -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_log_cleanup" model="ir.cron">

        <field name="name">[SCE] Cleanup Logs</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>


        <field name="priority">30</field>

        <field name="state">code</field>

        <field name="code">
env["sce.log.service"].cleanup()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Webhook Cleanup -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_webhook_cleanup" model="ir.cron">

        <field name="name">[SCE] Cleanup Webhooks</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>


        <field name="priority">40</field>

        <field name="state">code</field>

        <field name="code">
env["sce.webhook.service"].cleanup()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- General Maintenance -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_maintenance" model="ir.cron">

        <field name="name">[SCE] Maintenance</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>


        <field name="priority">50</field>

        <field name="state">code</field>

        <field name="code">
env["sce.kernel.service"].maintenance()
        </field>

    </record>

</odoo>