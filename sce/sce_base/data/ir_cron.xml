<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ========================================================= -->
    <!-- Queue Processor -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_queue_processor" model="ir.cron">

        <field name="name">[SCE] Process Queue</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">minutes</field>

        <field name="priority">5</field>

        <field name="model_id" ref="model_sce_queue_service"/>

        <field name="state">code</field>

        <field name="code">
env["sce.queue.service"].process_pending()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Retry Failed Jobs -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_retry_jobs" model="ir.cron">

        <field name="name">[SCE] Retry Failed Jobs</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">15</field>

        <field name="interval_type">minutes</field>


        <field name="priority">10</field>

        <field name="model_id" ref="model_sce_job"/>

        <field name="state">code</field>

        <field name="code">
    for job in env["sce.job"].search([("state", "=", "failed")]):
        if job.can_retry:
            job.retry()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Cache Cleanup -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_cache_cleanup" model="ir.cron">

        <field name="name">[SCE] Cleanup Cache</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">hours</field>


        <field name="priority">20</field>

        <field name="model_id" ref="model_sce_cache_service"/>

        <field name="state">code</field>

        <field name="code">
env["sce.cache.service"].cleanup()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Log Cleanup -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_log_cleanup" model="ir.cron">

        <field name="name">[SCE] Cleanup Logs</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>


        <field name="priority">30</field>

        <field name="model_id" ref="model_sce_log"/>

        <field name="state">code</field>

        <field name="code">
    env["sce.log"].cleanup_old_logs()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Webhook Cleanup -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_webhook_cleanup" model="ir.cron">

        <field name="name">[SCE] Cleanup Webhooks</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>


        <field name="priority">40</field>

        <field name="model_id" ref="model_sce_webhook"/>

        <field name="state">code</field>

        <field name="code">
    env["sce.webhook"].cleanup_old_webhooks()
        </field>

    </record>

    <!-- ========================================================= -->
    <!-- General Maintenance -->
    <!-- ========================================================= -->

    <record id="ir_cron_sce_maintenance" model="ir.cron">

        <field name="name">[SCE] Maintenance</field>

        <field name="active">True</field>

        <field name="user_id" ref="base.user_root"/>

        <field name="interval_number">1</field>

        <field name="interval_type">days</field>


        <field name="priority">50</field>

        <field name="model_id" ref="model_sce_kernel"/>

        <field name="state">code</field>

        <field name="code">
    env["sce.kernel"].cleanup()
        </field>

    </record>

</data>
</odoo>