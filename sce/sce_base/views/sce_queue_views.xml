<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Tree View -->
    <!-- ========================================================= -->

    <record id="view_sce_queue_tree" model="ir.ui.view">
        <field name="name">sce.queue.tree</field>
        <field name="model">sce.queue</field>
        <field name="arch" type="xml">

            <list string="Queue">

                <field name="name"/>

                <field name="connector_id"/>

                <field name="account_id"/>

                <field name="action"/>

                <field name="priority"/>

                <field name="state"
                       widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-primary="state == 'processing'"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"/>

                <field name="retry_count"/>

                <field name="scheduled_at"/>

                <field name="create_date"/>

            </list>

        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Form View -->
    <!-- ========================================================= -->

    <record id="view_sce_queue_form"
            model="ir.ui.view">

        <field name="name">sce.queue.form</field>

        <field name="model">sce.queue</field>

        <field name="arch"
               type="xml">

            <form string="Queue Item">

                <header>

                    <button name="action_execute"
                            type="object"
                            string="Execute"
                            class="btn-primary"
                            invisible="state != 'pending'"/>

                    <button name="action_retry"
                            type="object"
                            string="Retry"
                            invisible="not can_retry"/>

                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            invisible="state in ('done','failed','cancelled')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,processing,done,failed,cancelled"/>

                </header>

                <sheet>

                    <group>

                        <group>

                            <field name="name" readonly="1"/>

                            <field name="action"/>

                            <field name="account_id"/>

                            <field name="connector_id" readonly="1"/>

                            <field name="job_id"/>

                            <field name="priority"/>

                        </group>

                        <group>

                            <field name="scheduled_at"/>

                            <field name="started_at" readonly="1"/>

                            <field name="finished_at" readonly="1"/>

                            <field name="execution_time" readonly="1"/>

                            <field name="worker_id" readonly="1"/>

                            <field name="lock_date" readonly="1"/>

                        </group>

                    </group>

                    <notebook>

                        <!-- ===================================== -->

                        <page string="Payload">

                            <field name="payload"
                                   nolabel="1"/>

                        </page>

                        <!-- ===================================== -->

                        <page string="Result">

                            <field name="result"
                                   nolabel="1"
                                   readonly="1"/>

                        </page>

                        <!-- ===================================== -->

                        <page string="Provider Response">

                            <field name="response"
                                   nolabel="1"
                                   readonly="1"/>

                        </page>

                        <!-- ===================================== -->

                        <page string="Execution">

                            <group>

                                <group>

                                    <field name="records_processed"
                                           readonly="1"/>

                                    <field name="records_failed"
                                           readonly="1"/>

                                </group>

                                <group>

                                    <field name="retry_count"
                                           readonly="1"/>

                                    <field name="max_retries"/>

                                    <field name="can_retry"
                                           readonly="1"/>

                                </group>

                            </group>

                        </page>

                        <!-- ===================================== -->

                        <page string="Errors">

                            <group>

                                <field name="error"
                                       readonly="1"/>

                                <field name="error_traceback"
                                       readonly="1"/>

                            </group>

                        </page>

                        <!-- ===================================== -->

                        <page string="Description">

                            <field name="description"
                                   nolabel="1"/>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Search View -->
    <!-- ========================================================= -->

    <record id="view_sce_queue_search"
            model="ir.ui.view">

        <field name="name">sce.queue.search</field>

        <field name="model">sce.queue</field>

        <field name="arch"
               type="xml">

            <search>

                <field name="name"/>

                <field name="account_id"/>

                <field name="connector_id"/>

                <field name="action"/>

                <separator/>

                <filter string="Pending"
                        name="pending"
                        domain="[('state','=','pending')]"/>

                <filter string="Processing"
                        name="processing"
                        domain="[('state','=','processing')]"/>

                <filter string="Done"
                        name="done"
                        domain="[('state','=','done')]"/>

                <filter string="Failed"
                        name="failed"
                        domain="[('state','=','failed')]"/>

                <filter string="Cancelled"
                        name="cancelled"
                        domain="[('state','=','cancelled')]"/>

                <separator/>

                <filter string="Retry Available"
                        name="retry"
                        domain="[('can_retry','=',True)]"/>

                  <group>

                    <filter string="State"
                            name="group_by_state"
                            context="{'group_by':'state'}"/>

                    <filter string="Connector"
                            name="group_by_connector"
                            context="{'group_by':'connector_id'}"/>

                    <filter string="Account"
                            name="group_by_account"
                            context="{'group_by':'account_id'}"/>

                    <filter string="Priority"
                            name="group_by_priority"
                            context="{'group_by':'priority'}"/>

                </group>

            </search>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Action -->
    <!-- ========================================================= -->

    <record id="action_sce_queue"
            model="ir.actions.act_window">

        <field name="name">Queue</field>

        <field name="res_model">sce.queue</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_sce_queue_search"/>

        <field name="help"
               type="html">

            <p class="o_view_nocontent_smiling_face">
                Queue is empty.
            </p>

            <p>
                Queue items are automatically generated by
                Softwork Commerce Engine to execute background tasks.
            </p>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Menu -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_sce_queue"
        action="action_sce_queue"/>

</odoo>