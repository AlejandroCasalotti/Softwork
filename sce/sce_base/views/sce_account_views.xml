<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- Tree View -->
    <!-- ========================================================= -->

    <record id="view_sce_account_tree"
            model="ir.ui.view">

        <field name="name">sce.account.tree</field>

        <field name="model">sce.account</field>

        <field name="arch" type="xml">

            <list string="Marketplace Accounts">

                <field name="name"/>

                <field name="connector_id"/>

                <field name="external_user_name"/>

                <field name="company_id"/>

                <field name="state"
                       widget="badge"
                       decoration-success="state == 'connected'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'error'"/>

                <field name="last_sync"/>

                <field name="active"/>

            </list>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Form View -->
    <!-- ========================================================= -->

    <record id="view_sce_account_form"
            model="ir.ui.view">

        <field name="name">sce.account.form</field>

        <field name="model">sce.account</field>

        <field name="arch"
               type="xml">

            <form string="Marketplace Account">

                <header>

                    <button name="action_connect"
                            type="object"
                            string="Connect"
                            class="btn-primary"
                            invisible="state == 'connected'"/>

                    <button name="action_disconnect"
                            type="object"
                            string="Disconnect"
                            invisible="state != 'connected'"/>

                    <button name="action_test_connection"
                            type="object"
                            string="Test Connection"/>

                    <button name="action_synchronize"
                            type="object"
                            string="Synchronize"
                            class="btn-primary"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,connected,error,disabled"/>

                </header>

                <sheet>

                    <!-- Smart Buttons -->

                    <div class="oe_button_box"
                         name="button_box">

                        <button class="oe_stat_button"
                                icon="fa-tasks">

                            <field name="job_count"
                                   widget="statinfo"
                                   string="Jobs"/>

                        </button>

                        <button class="oe_stat_button"
                                icon="fa-list">

                            <field name="queue_count"
                                   widget="statinfo"
                                   string="Queue"/>

                        </button>

                        <button class="oe_stat_button"
                                icon="fa-file-text-o">

                            <field name="log_count"
                                   widget="statinfo"
                                   string="Logs"/>

                        </button>

                        <button class="oe_stat_button"
                                icon="fa-rss">

                            <field name="webhook_count"
                                   widget="statinfo"
                                   string="Webhooks"/>

                        </button>

                    </div>

                    <notebook>

                        <!-- ================================================= -->

                        <page string="General">

                            <group>

                                <group>

                                    <field name="name"/>

                                    <field name="connector_id"/>

                                    <field name="company_id"/>

                                    <field name="active"/>

                                </group>

                                <group>

                                    <field name="external_user_id"/>

                                    <field name="external_user_name"/>

                                    <field name="external_email"/>

                                </group>

                            </group>

                        </page>

                        <!-- ================================================= -->

                        <page string="Authentication">

                            <group>

                                <group>

                                    <field name="auth_type"/>

                                    <field name="client_id"/>

                                    <field name="client_secret"
                                           password="True"/>

                                </group>

                                <group>

                                    <field name="access_token"
                                           password="True"/>

                                    <field name="refresh_token"
                                           password="True"/>

                                    <field name="token_expiration"/>

                                </group>

                            </group>

                        </page>

                        <!-- ================================================= -->

                        <page string="Connection">

                            <group>

                                <group>

                                    <field name="api_url"/>

                                    <field name="redirect_uri"/>

                                    <field name="sandbox"/>

                                </group>

                                <group>

                                    <field name="last_connection"
                                           readonly="1"/>

                                    <field name="last_sync"
                                           readonly="1"/>

                                    <field name="connected"
                                           readonly="1"/>

                                </group>

                            </group>

                        </page>

                        <!-- ================================================= -->

                        <page string="Synchronization">

                            <group>

                                <group>

                                    <field name="auto_sync"/>

                                    <field name="sync_interval"/>

                                </group>

                                <group>

                                    <field name="sync_products"/>

                                    <field name="sync_orders"/>

                                    <field name="sync_stock"/>

                                    <field name="sync_prices"/>

                                    <field name="sync_shipments"/>

                                </group>

                            </group>

                        </page>

                        <!-- ================================================= -->

                        <page string="Statistics">

                            <group>

                                <group>

                                    <field name="products_synced"
                                           readonly="1"/>

                                    <field name="orders_synced"
                                           readonly="1"/>

                                    <field name="shipments_synced"
                                           readonly="1"/>

                                </group>

                                <group>

                                    <field name="last_sync_status"
                                           readonly="1"/>

                                    <field name="last_sync_message"
                                           readonly="1"/>

                                    <field name="error_count"
                                           readonly="1"/>

                                </group>

                            </group>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Search -->
    <!-- ========================================================= -->

    <record id="view_sce_account_search"
            model="ir.ui.view">

        <field name="name">sce.account.search</field>

        <field name="model">sce.account</field>

        <field name="arch"
               type="xml">

            <search>

                <field name="name"/>

                <field name="connector_id"/>

                <field name="external_user_name"/>

                <field name="company_id"/>

                <separator/>

                <filter string="Connected"
                        name="connected"
                        domain="[('state','=','connected')]"/>

                <filter string="Draft"
                        name="draft"
                        domain="[('state','=','draft')]"/>

                <filter string="Error"
                        name="error"
                        domain="[('state','=','error')]"/>

                <filter string="Disabled"
                        name="disabled"
                        domain="[('state','=','disabled')]"/>

                <group string="Group By"
                       expand="0">

                    <filter string="Connector"
                            context="{'group_by':'connector_id'}"/>

                    <filter string="Company"
                            context="{'group_by':'company_id'}"/>

                    <filter string="Status"
                            context="{'group_by':'state'}"/>

                </group>

            </search>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Action -->
    <!-- ========================================================= -->

    <record id="action_sce_account"
            model="ir.actions.act_window">

        <field name="name">Accounts</field>

        <field name="res_model">sce.account</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id"
               ref="view_sce_account_search"/>

        <field name="help"
               type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first marketplace account.
            </p>

            <p>
                Marketplace accounts store the authentication and
                synchronization configuration used by Softwork Commerce Engine.
            </p>

        </field>

    </record>

    <!-- ========================================================= -->
    <!-- Menu -->
    <!-- ========================================================= -->

    <menuitem
        id="menu_sce_account"
        action="action_sce_account"/>

</odoo>