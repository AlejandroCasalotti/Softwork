<?xml version="1.0" encoding="utf-8"?>

<odoo>


    <!-- ================================================= -->
    <!-- Accounts -->
    <!-- ================================================= -->


    <record id="rule_sce_account_company"
            model="ir.rule">


        <field name="name">
            SCE Account Multi Company
        </field>


        <field name="model_id"
               ref="model_sce_account"/>


        <field name="domain_force">

            [('company_id','in',company_ids)]

        </field>


    </record>



    <!-- ================================================= -->
    <!-- Jobs -->
    <!-- ================================================= -->


    <record id="rule_sce_job_company"
            model="ir.rule">


        <field name="name">
            SCE Job Multi Company
        </field>


        <field name="model_id"
               ref="model_sce_job"/>


        <field name="domain_force">

            [('company_id','in',company_ids)]

        </field>


    </record>



    <!-- ================================================= -->
    <!-- Queue -->
    <!-- ================================================= -->


    <record id="rule_sce_queue_company"
            model="ir.rule">


        <field name="name">
            SCE Queue Multi Company
        </field>


        <field name="model_id"
               ref="model_sce_queue"/>


        <field name="domain_force">

            [('company_id','in',company_ids)]

        </field>


    </record>



</odoo>