<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ============================================================= -->
    <!-- Category -->
    <!-- ============================================================= -->

    <record id="module_category_sce" model="ir.module.category">

        <field name="name">Softwork Commerce Engine</field>

        <field name="description">
            Security groups for the Softwork Commerce Engine.
        </field>

        <field name="sequence">50</field>

    </record>

    <!-- ============================================================= -->
    <!-- SCE Administrator -->
    <!-- ============================================================= -->

    <record id="group_sce_manager" model="res.groups">

        <field name="name">
            SCE Manager
        </field>

    </record>

    <!-- ============================================================= -->
    <!-- SCE User -->
    <!-- ============================================================= -->

    <record id="group_sce_user" model="res.groups">

        <field name="name">
            SCE User
        </field>

        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>

    </record>

    <!-- ============================================================= -->
    <!-- SCE Read Only -->
    <!-- ============================================================= -->

    <record id="group_sce_readonly" model="res.groups">

        <field name="name">
            SCE Read Only
        </field>

        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>

    </record>

</odoo>